-- DRAG SUPPORT: mouse + touch
local dragging = false
local dragStart
local startPosition

Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then

        dragging = true
        dragStart = input.Position
        startPosition = Main.Position

        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (
        input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
    ) then
        local delta = input.Position - dragStart

        Main.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end
end)

-- ESP FUNCTIONS
local function removeESP(object)
    local data = tracked[object]
    if data then
        if data.Highlight then
            data.Highlight:Destroy()
        end

        if data.Billboard then
            data.Billboard:Destroy()
        end

        tracked[object] = nil
    end
end

local function createESP(object, espType)
    if tracked[object] or not object:IsA("Model") then
        return
    end

    if not object:FindFirstChildWhichIsA("BasePart", true) then
        return
    end

    local config = ESP_TYPES[espType]
    if not config then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ESP_Highlight"
    highlight.Adornee = object
    highlight.FillColor = config.Color
    highlight.OutlineColor = config.Color
    highlight.FillTransparency = 0.65
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = ESP_FOLDER

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "ESP_Label"
    billboard.Adornee = object:FindFirstChild("HumanoidRootPart")
        or object.PrimaryPart
        or object:FindFirstChildWhichIsA("BasePart", true)

    billboard.Size = UDim2.fromOffset(150, 30)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.Parent = ESP_FOLDER

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1
    label.Text = "[" .. espType .. "] " .. object.Name
    label.TextColor3 = config.Color
    label.TextStrokeTransparency = 0
    label.TextSize = 13
    label.Font = Enum.Font.GothamBold
    label.Parent = billboard

    tracked[object] = {
        Highlight = highlight,
        Billboard = billboard,
        Type = espType
    }
end

-- DETECT OBJECT TYPE
local function getObjectType(object)
    if not object:IsA("Model") then
        return nil
    end

    local name = string.lower(object.Name)

    if object:GetAttribute("IsPet") == true
        or name:find("pet") then
        return "Pet"

    elseif name:find("egg") then
        return "Egg"

    elseif name:find("chest")
        or name:find("treasure") then
        return "Chest"

    elseif name:find("npc")
        or name:find("monster")
        or name:find("enemy") then
        return "NPC"

    elseif name:find("item")
        or name:find("drop")
        or name:find("coin") then
        return "Item"
    end

    return nil
end

-- PLAYER ESP
local function updatePlayers()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and ESP_TYPES.Player.Enabled then
            local character = player.Character

            if character then
                if not tracked[character] then
                    createESP(character, "Player")
                end
            end
        end
    end
end

-- OBJECT ESP
local function updateObjects()
    for _, object in ipairs(Workspace:GetDescendants()) do
        if object:IsA("Model") then
            local espType = getObjectType(object)

            if espType and ESP_TYPES[espType].Enabled then
                createESP(object, espType)
            end
        end
    end
end

-- BUTTONS
local function createButton(name, config)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(0.9, 0, 0, 35)
    button.BackgroundColor3 = Color3.fromRGB(55, 55, 70)
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 13
    button.Font = Enum.Font.GothamBold
    button.Parent = Content

    local function refresh()
        button.Text = name .. " : " ..
            (config.Enabled and "ON" or "OFF")

        button.BackgroundColor3 = config.Enabled
            and Color3.fromRGB(35, 130, 75)
            or Color3.fromRGB(55, 55, 70)
    end

    button.MouseButton1Click:Connect(function()
        config.Enabled = not config.Enabled

        if not config.Enabled then
            for object, data in pairs(tracked) do
                if data.Type == name then
                    removeESP(object)
                end
            end
        end

        refresh()
    end)

    refresh()
end

for name, config in pairs(ESP_TYPES) do
    createButton(name .. " ESP", config)
end

-- MINIMIZE BUTTON
local minimized = false

Minimize.MouseButton1Click:Connect(function()
    minimized = not minimized
    Content.Visible = not minimized
    Main.Size = minimized
        and UDim2.fromOffset(235, 38)
        or UDim2.fromOffset(235, 330)

    Minimize.Text = minimized and "+" or "-"
end)

-- DESTROY BUTTON
Destroy.MouseButton1Click:Connect(function()
    ESP_FOLDER:Destroy()
    ScreenGui:Destroy()
    tracked = {}
end)

-- MAIN LOOP
task.spawn(function()
    while ScreenGui.Parent do
        updatePlayers()
        updateObjects()

        for object in pairs(tracked) do
            if not object.Parent then
                removeESP(object)
            end
        end

        task.wait(SCAN_INTERVAL)
    end
end)

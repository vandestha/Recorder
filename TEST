                    1
                )

            fileBtn.MouseEnter:Connect(function()
                if stroke.Color ~= THEME.Accent then
                    TweenService:Create(
                        fileBtn,
                        TweenInfo.new(0.2),
                        {
                            BackgroundTransparency = 0.8,
                            TextColor3 = THEME.TextWhite
                        }
                    ):Play()
                end
            end)

            fileBtn.MouseLeave:Connect(function()
                if stroke.Color ~= THEME.Accent then
                    TweenService:Create(
                        fileBtn,
                        TweenInfo.new(0.2),
                        {
                            BackgroundTransparency = 1,
                            TextColor3 = THEME.TextWhite
                        }
                    ):Play()
                end
            end)

            fileBtn.MouseButton1Click:Connect(function()
                FileInput.Text = fileName

                local data =
                    FSM:Load(fileName)

                if data then
                    local loaded =
                        MacroEngine:LoadCompetitorJSON(data)

                    if not loaded then
                        StatusPanel.Text =
                            "Status: Load Failed"
                        RecorderStatus.Text =
                            StatusPanel.Text
                        return
                    end

                    StatusPanel.Text =
                        "Status: Loaded ("
                        .. #MacroEngine.Frames
                        .. " F)"

                    for _, b in ipairs(
                        FileScroll:GetChildren()
                    ) do
                        if b:IsA("TextButton") then
                            TweenService:Create(
                                b,
                                TweenInfo.new(0.2),
                                {
                                    BackgroundTransparency = 1,
                                    TextColor3 = THEME.TextWhite
                                }
                            ):Play()

                            b.UIStroke.Color =
                                THEME.Outline
                        end
                    end

                    TweenService:Create(
                        fileBtn,
                        TweenInfo.new(0.2),
                        {
                            BackgroundTransparency = 0.6,
                            TextColor3 = THEME.TextWhite
                        }
                    ):Play()

                    stroke.Color =
                        THEME.Accent

                    if MacroEngine.ShowPath then
                        pcall(function()
                            if MacroEngine.ShowPath then
                        MacroEngine:RenderPath()
                    end
                        end)
                    end

                    local visualStroke = FloatingVisualBtn:FindFirstChildOfClass("UIStroke")
                    FloatingVisualBtn.Text = MacroEngine.ShowPath and "VISUAL: ON" or "VISUAL: OFF"
                    if visualStroke then
                        visualStroke.Color = MacroEngine.ShowPath and THEME.Action.Pause or THEME.Outline
                    end
                end
            end)
        end
    end
end


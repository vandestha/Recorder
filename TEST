local graphicsEnabled = false

local graphicsSaved =
    setmetatable(
        {},
        {
            __mode = "k"
        }
    )

local function saveGraphicsProperty(
    obj,
    property
)
    if not obj then
        return
    end

    if graphicsSaved[obj] == nil then
        graphicsSaved[obj] = {}
    end

    if graphicsSaved[obj][property] == nil then
        local ok, value =
            pcall(function()
                return obj[property]
            end)

        if ok then
            graphicsSaved[obj][property] =
                value
        end
    end
end

local function setGraphicsProperty(
    obj,
    property,
    value
)
    pcall(function()
        obj[property] = value
    end)
end

local function optimizeGraphicsObject(obj)
    if obj:IsA("BasePart") then
        saveGraphicsProperty(
            obj,
            "CastShadow"
        )

        setGraphicsProperty(
            obj,
            "CastShadow",
            false
        )
    end

    if obj:IsA("MeshPart") then
        saveGraphicsProperty(
            obj,
            "RenderFidelity"
        )

        setGraphicsProperty(
            obj,
            "RenderFidelity",
            Enum.RenderFidelity.Performance
        )
    end

    if
        obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
        or obj:IsA("Smoke")
        or obj:IsA("Fire")
        or obj:IsA("Sparkles")
    then
        saveGraphicsProperty(
            obj,
            "Enabled"
        )

        setGraphicsProperty(
            obj,
            "Enabled",
            false
        )
    end

    if
        obj:IsA("BloomEffect")
        or obj:IsA("BlurEffect")
        or obj:IsA("ColorCorrectionEffect")
        or obj:IsA("DepthOfFieldEffect")
        or obj:IsA("SunRaysEffect")
    then
        saveGraphicsProperty(
            obj,
            "Enabled"
        )

        setGraphicsProperty(
            obj,
            "Enabled",
            false
        )
    end

    if
        obj:IsA("PointLight")
        or obj:IsA("SpotLight")
        or obj:IsA("SurfaceLight")
    then
        saveGraphicsProperty(
            obj,
            "Enabled"
        )

        setGraphicsProperty(
            obj,
            "Enabled",
            false
        )
    end
end

local function optimizeGraphics()
    saveGraphicsProperty(
        Lighting,
        "GlobalShadows"
    )

    setGraphicsProperty(
        Lighting,
        "GlobalShadows",
        false
    )

    local terrain =
        workspace:FindFirstChildOfClass(
            "Terrain"
        )

    if terrain then
        for _, property in ipairs({
            "WaterWaveSize",
            "WaterWaveSpeed",
            "WaterReflectance",
            "WaterTransparency"
        }) do
            saveGraphicsProperty(
                terrain,
                property
            )
        end

        setGraphicsProperty(
            terrain,
            "WaterWaveSize",
            0
        )

        setGraphicsProperty(
            terrain,
            "WaterWaveSpeed",
            0
        )

        setGraphicsProperty(
            terrain,
            "WaterReflectance",
            0
        )

        setGraphicsProperty(
            terrain,
            "WaterTransparency",
            1
        )
    end

    for _, obj in ipairs(
        game:GetDescendants()
    ) do
        optimizeGraphicsObject(obj)
    end
end

local function restoreGraphics()
    for obj, properties in pairs(
        graphicsSaved
    ) do
        if obj and obj.Parent then
            for property, value in pairs(
                properties
            ) do
                setGraphicsProperty(
                    obj,
                    property,
                    value
                )
            end
        end
    end

    table.clear(graphicsSaved)
end

game.DescendantAdded:Connect(function(obj)
    if graphicsEnabled then
        task.defer(function()
            if
                graphicsEnabled
                and obj.Parent
            then
                optimizeGraphicsObject(obj)
            end
        end)
    end
end)


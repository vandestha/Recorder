function MacroEngine:CleanUp()
    for _, item in ipairs(self.Bin) do
        if typeof(item) == "RBXScriptConnection" then
            pcall(function()
                item:Disconnect()
            end)
        elseif typeof(item) == "Instance" then
            pcall(function()
                item:Destroy()
            end)
        end
    end

    table.clear(self.Bin)

    if self.LastM1State then
        pcall(function()
            VirtualInputManager:SendMouseButtonEvent(
                0,
                0,
                0,
                false,
                game,
                1
            )
        end)

        self.LastM1State = false
    end

    self.IsLoopWaiting = false
    self:ResetCharacterState()
end

function MacroEngine:ResetCharacterState()
    local char = LocalPlayer.Character

    if not char then
        self:CleanUpMovers()
        return
    end

    local hum = char:FindFirstChildOfClass("Humanoid")

    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
    end

    local animate = char:FindFirstChild("Animate")

    if animate then
        animate.Disabled = false
    end

    self:CleanUpMovers()
end


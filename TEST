function MacroEngine:GetAnimId(assetStr)
    if not self.AnimDict[assetStr] then
        self.AnimDict[assetStr] = self.DictCounter
        self.DictCounter = self.DictCounter + 1
    end

    return self.AnimDict[assetStr]
end

function MacroEngine:GetAnimAssetById(animIndex)
    animIndex = tonumber(animIndex)
    if not animIndex then
        return nil
    end

    for assetId, index in pairs(self.AnimDict) do
        if tonumber(index) == animIndex then
            return assetId
        end
    end

    return nil
end

-- ========== CLIMB ANIMATION HELPER ==========
-- STOP tidak menggunakan freeze/Anchored. Track dihentikan normal agar
-- Animate dapat mengambil alih kembali. Posisi STOP dijaga lewat CFrame.
local function clearFrozenClimbPose()
    pcall(function()
        if activeClimbTrack then
            activeClimbTrack:Stop(0.12)
            activeClimbTrack:Destroy()
        end
    end)
    activeClimbTrack = nil
    activeClimbHumanoid = nil
end

local function stopClimbAnimation()
    pcall(function()
        if activeClimbTrack then
            activeClimbTrack:Stop(0.15)
            activeClimbTrack:Destroy()
        end
    end)

    activeClimbTrack = nil
    activeClimbHumanoid = nil
end

local function stopClimbPresentation(character)
    stopClimbAnimation()

    if MacroEngine then
        MacroEngine._LastPlaybackHumanoidState = nil
    end
end

local function getClimbAnimationId(character)
    local animate = character and character:FindFirstChild("Animate")
    if animate then
        local climbFolder = animate:FindFirstChild("climb")
        if climbFolder then
            local climbAnim = climbFolder:FindFirstChild("ClimbAnim")
            if climbAnim and climbAnim:IsA("Animation") and climbAnim.AnimationId ~= "" then
                return climbAnim.AnimationId
            end
        end
    end

    -- Sama seperti kompetitor: fallback ke ClimbAnim Roblox default.
    return "rbxassetid://180436334"
end

local function playClimbAnimation(character, humanoid, climbSpeed)
    if not character or not humanoid then return end

    pcall(function()
        if activeClimbHumanoid ~= humanoid then
            stopClimbAnimation()

            local animator = humanoid:FindFirstChildOfClass("Animator")
            if not animator then
                animator = Instance.new("Animator")
                animator.Parent = humanoid
            end

            local anim = Instance.new("Animation")
            anim.AnimationId = getClimbAnimationId(character)

            activeClimbTrack = animator:LoadAnimation(anim)
            activeClimbTrack.Priority = Enum.AnimationPriority.Movement
            activeClimbTrack.Looped = true
            activeClimbHumanoid = humanoid
        end

        if activeClimbTrack and not activeClimbTrack.IsPlaying then
            activeClimbTrack:Play(0.1, 1, 1)
        end

        if activeClimbTrack then
            local animSpeed = math.clamp(math.abs(climbSpeed or 8) / 8, 0.6, 2.5)
            activeClimbTrack:AdjustSpeed(animSpeed)
        end
    end)
end


function MacroEngine:GetClosestFrame(currentPos)
    if #self.Frames == 0 then
        return 1, 0
    end

    local minSqDist = math.huge
    local closestIdx = 1

    for i, frame in ipairs(self.Frames) do
        local sqDist =
            (currentPos - Vector3.new(
                frame.px,
                frame.py,
                frame.pz
            )).Magnitude

        if sqDist < minSqDist then
            minSqDist = sqDist
            closestIdx = i
        end
    end

    return closestIdx, self.Frames[closestIdx].t
end

function MacroEngine:BuildCompetitorJSON()
    local output = {}

    -- JSON playback hanya menyimpan data inti:
    -- HipHeight, Velocity, Position, Rotation, MoveDirection, Time,
    -- Jumping, Walkspeed, Tool, dan State.
    -- Data animasi climb tambahan tidak diekspor; playback climb tetap
    -- menggunakan metode target-position yang sudah dipertahankan.
    for _, frame in ipairs(self.Frames) do
        local lx = tonumber(frame.lx) or 0
        local lz = tonumber(frame.lz) or 0
        local rotation = tonumber(frame.rotation)

        if rotation == nil then
            if math.abs(lx) > 0.000001 or math.abs(lz) > 0.000001 then
                rotation = math.atan2(-lx, -lz)
            else
                rotation = 0
            end
        end

        local stateValue = tonumber(frame.stateValue)
        if stateValue == nil and frame.humanoidState then
            local stateItem = Enum.HumanoidStateType[frame.humanoidState]
            if stateItem then
                stateValue = stateItem.Value
            end
        end

        local outputFrame = {
            HipHeight = tonumber(frame.hipHeight) or 0,
            Velocity = {
                x = tonumber(frame.vx) or 0,
                y = tonumber(frame.vy) or 0,
                z = tonumber(frame.vz) or 0
            },
            Position = {
                x = tonumber(frame.px) or 0,
                y = tonumber(frame.py) or 0,
                z = tonumber(frame.pz) or 0
            },
            Rotation = rotation,
            MoveDirection = {
                x = tonumber(frame.mdx) or 0,
                y = tonumber(frame.mdy) or 0,
                z = tonumber(frame.mdz) or 0
            },
            Time = tonumber(frame.t) or 0,
            Jumping = frame.jump == true,
            Walkspeed = tonumber(frame.walkSpeed) or 16,
            Tool = frame.tool,
            State = stateValue or Enum.HumanoidStateType.Running.Value
        }

        if frame.climbPhase ~= nil then
            outputFrame.ClimbPhase = tonumber(frame.climbPhase)
        end

        output[#output + 1] = outputFrame
    end

    return output
end

function MacroEngine:LoadCompetitorJSON(data)
    if type(data) ~= "table" then
        return false
    end

    local frames = {}

    for i = 1, #data do
        local item = data[i]

        -- Kompatibel dengan format field inti lama maupun nama field yang
        -- ditulis dengan huruf kapital.
        local pos = item and (item.position or item.Position)
        local vel = item and (item.velocity or item.Velocity)
        local md = item and (item.moveDirection or item.MoveDirection)
        local rotationValue = item and (item.rotation or item.Rotation)
        local timeValue = item and (item.time or item.Time)
        local jumpValue = item and (item.jumping or item.Jumping)
        local walkSpeedValue = item and (item.walkSpeed or item.Walkspeed or item.WalkSpeed)
        local toolValue = item and (item.tool or item.Tool)
        local stateValue = item and (item.state or item.State)
        local hipHeightValue = item and (item.hipHeight or item.HipHeight)

        if type(item) == "table"
            and type(pos) == "table"
            and type(vel) == "table"
        then
            local yaw = tonumber(rotationValue) or 0
            local stateNumber = tonumber(stateValue)

            frames[#frames + 1] = {
                hipHeight = tonumber(hipHeightValue) or 2,
                px = tonumber(pos.x or pos.X) or 0,
                py = tonumber(pos.y or pos.Y) or 0,
                pz = tonumber(pos.z or pos.Z) or 0,
                vx = tonumber(vel.x or vel.X) or 0,
                vy = tonumber(vel.y or vel.Y) or 0,
                vz = tonumber(vel.z or vel.Z) or 0,
                rotation = yaw,
                mdx = tonumber(md and (md.x or md.X)) or 0,
                mdy = tonumber(md and (md.y or md.Y)) or 0,
                mdz = tonumber(md and (md.z or md.Z)) or 0,
                t = tonumber(timeValue) or 0,
                jump = jumpValue == true,
                walkSpeed = tonumber(walkSpeedValue) or 16,
                tool = toolValue,
                stateValue = stateNumber,
                climbTp = tonumber(item.climbTp or item.ClimbTp),
                climbSpeed = tonumber(item.climbSpeed or item.ClimbSpeed),
                climbWeight = tonumber(item.climbWeight or item.ClimbWeight),
                climbPhase = tonumber(item.climbPhase or item.ClimbPhase),
                -- Data competitor menyimpan posisi karakter/root.
                -- Tandai agar RenderPath mengubahnya ke titik tengah kedua kaki
                -- saat VisualPath dirender.
                pathX = tonumber(pos.x or pos.X) or 0,
                pathY = tonumber(pos.y or pos.Y) or 0,
                pathZ = tonumber(pos.z or pos.Z) or 0,
                pathFromRoot = true,
                lx = -math.sin(yaw),
                ly = 0,
                lz = -math.cos(yaw)
            }
        end
    end

    if #frames == 0 then
        return false
    end

    self.Frames = frames
    self.CurrentTime = 0
    self.PlaybackIndex = 1
    self.LastPlaybackPosition = nil
    self.LastPlaybackFrameIndex = nil
    return true
end


function MacroEngine:Record()
    if self.State ~= "Idle" then
        self:Stop()
    end

    self:CleanUp()

    table.clear(self.Frames)
    table.clear(self.AnimDict)

    self.DictCounter = 1
    self.StartTime = os.clock()
    self.State = "Recording"
    self.IsLoopWaiting = false
    -- Version ini dipakai untuk memberi tahu Heartbeat recorder bahwa UNDO
    -- baru saja memindahkan titik awal internal ke frame terakhir yang tersisa.
    self._RecordSyncVersion = (self._RecordSyncVersion or 0) + 1

    if self.PathFolder then
        self.PathFolder:Destroy()
        self.PathFolder = nil
    end

    if self.ShowPath then
        self.PathFolder = Instance.new("Folder")
        self.PathFolder.Name = "boneto_VisualPath"
        self.PathFolder.Parent = workspace
    end

    local char =
        LocalPlayer.Character
        or LocalPlayer.CharacterAdded:Wait()

    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")
    local initialPathPosition = getVisualPathFootCenter(char, root, hum) or root.Position

    -- Saat RECORD, biarkan Humanoid mengikuti arah input/kamera.
    -- Jika AutoRotate=false di sini, karakter akan terkunci menghadap satu arah
    -- sehingga belok kiri/kanan tidak ikut terekam dengan benar.
    hum.AutoRotate = true

    local initialToolObj = char:FindFirstChildOfClass("Tool")
    local initialToolName =
        initialToolObj
        and initialToolObj.Name
        or nil

    -- Untuk climb, simpan waktu/speed/weight animasi yang sedang aktif.
    -- Asset ID tidak direkam; playback tetap mengambil ClimbAnim dari Animate.
    -- Data ini menjadi timeline kaki yang dipakai kembali saat playback.
    local recordAnimator = hum:FindFirstChildOfClass("Animator")
        or hum:WaitForChild("Animator", 2)
    local climbAnimationIdForRecord = getClimbAnimationId(char)

    local lastPos = root.Position
    local lastRot = root.CFrame.LookVector
    -- Posisi terakhir yang benar-benar menjadi ujung VisualPath.
    -- Nilai ini ikut diperbarui oleh UNDO agar garis berikutnya menyambung
    -- dari frame terakhir, bukan dari posisi sebelum UNDO.
    self.RecordLastPosition = initialPathPosition
    local lastM1 = self.IsM1Down
    local lastTool = initialToolName
    local lastHumanoidState = hum:GetState()
    -- V27.5: phase siklus animasi Climb yang direkam secara kontinu.
    -- Jangan bergantung pada TimePosition mentah yang pada recording sebelumnya
    -- bisa hampir tidak bergerak walaupun karakter terus menaiki ladder.
    local climbPhase = 0
    local climbPhaseAnimationId = nil
    local wasRecordingClimbAnimation = false

    local activeRecordTime = 0
    local lastSampleTime = os.clock()
    -- V28.6 experiment: pisahkan frekuensi Heartbeat dari frekuensi sample Record.
    -- Mengikuti metode kompetitor: target sample sekitar 25 Hz (0.04 s).
    local recordSampleAccumulator = 0
    local seenRecordSyncVersion = self._RecordSyncVersion or 0

    table.insert(self.Frames, {
        t = 0,
        hipHeight = hum.HipHeight,
        px = root.Position.X,
        py = root.Position.Y,
        pz = root.Position.Z,
        pathX = initialPathPosition.X,
        pathY = initialPathPosition.Y,
        pathZ = initialPathPosition.Z,
        vx = root.AssemblyLinearVelocity.X,
        vy = root.AssemblyLinearVelocity.Y,
        vz = root.AssemblyLinearVelocity.Z,
        avx = root.AssemblyAngularVelocity.X,
        avy = root.AssemblyAngularVelocity.Y,
        avz = root.AssemblyAngularVelocity.Z,
        lx = root.CFrame.LookVector.X,
        ly = root.CFrame.LookVector.Y,
        lz = root.CFrame.LookVector.Z,
        mdx = 0,
        mdy = 0,
        mdz = 0,
        jump = false,
        rawJump = false,
        stateChanged = true,
        recordedDt = 0,
        walkSpeed = tonumber(hum.WalkSpeed) or 16,
        rawState = hum:GetState().Name,
        humanoidState = hum:GetState().Name,
        stateValue = hum:GetState().Value,
        tool = initialToolName,
        m1 = self.IsM1Down,
        climbPhase = nil
    })

    table.insert(
        self.Bin,
        RunService.Heartbeat:Connect(function()
            if hum.Health <= 0 then
                self.State = "Idle"
                self:CleanUp()
                return
            end

            local now = os.clock()

            -- UNDO dapat menghapus frame dan memindahkan karakter ke frame lama.
            -- Sinkronkan seluruh baseline recorder sebelum menghitung delta berikutnya,
            -- supaya perpindahan akibat UNDO tidak direkam sebagai gerakan baru yang besar.
            local currentSyncVersion = self._RecordSyncVersion or 0
            if currentSyncVersion ~= seenRecordSyncVersion then
                seenRecordSyncVersion = currentSyncVersion

                local syncFrame = self.Frames[#self.Frames]
                if syncFrame then
                    lastPos = Vector3.new(
                        tonumber(syncFrame.px) or root.Position.X,
                        tonumber(syncFrame.py) or root.Position.Y,
                        tonumber(syncFrame.pz) or root.Position.Z
                    )
                    lastRot = Vector3.new(
                        tonumber(syncFrame.lx) or root.CFrame.LookVector.X,
                        tonumber(syncFrame.ly) or root.CFrame.LookVector.Y,
                        tonumber(syncFrame.lz) or root.CFrame.LookVector.Z
                    )
                    if lastRot.Magnitude < 0.001 then
                        lastRot = root.CFrame.LookVector
                    end
                    lastM1 = syncFrame.m1 == true
                    lastTool = syncFrame.tool
                    lastHumanoidState = hum:GetState()
                    activeRecordTime = tonumber(syncFrame.t) or 0

                    -- Setelah UNDO, pertahankan state frame terakhir agar Roblox
                    -- tidak sempat masuk ke pose Idle sebelum sample berikutnya.
                    -- Ini hanya menyelaraskan state animasi; velocity dan timeline
                    -- Playback tidak disentuh.
                    local syncStateName = syncFrame.humanoidState
                    local syncStateEnum = syncStateName and Enum.HumanoidStateType[syncStateName]
                    if syncStateEnum then
                        pcall(function()
                            hum:ChangeState(syncStateEnum)
                        end)
                        lastHumanoidState = syncStateEnum
                    end

                else
                    lastPos = root.Position
                    lastRot = root.CFrame.LookVector
                    lastM1 = self.IsM1Down
                    lastTool = nil
                    lastHumanoidState = hum:GetState()
                    activeRecordTime = 0
                end

                -- Jangan biarkan delta waktu Heartbeat sebelum/sesudah teleport UNDO
                -- masuk ke timeline. Sample berikutnya dimulai dari baseline baru.
                lastSampleTime = now
                recordSampleAccumulator = 0
                return
            end

            -- V28.6: Heartbeat tetap menjadi clock, tetapi Record tidak lagi
            -- mengambil sample setiap Heartbeat. Target sampling ~25 Hz, seperti
            -- metode kompetitor (SAMPLE_INTERVAL = 0.04). Ini hanya mengurangi
            -- noise/sample berlebih; tidak mengubah Physics/Heartbeat Roblox.
            recordSampleAccumulator += math.max(0, now - lastSampleTime)
            if recordSampleAccumulator < 0.04 then
                return
            end
            recordSampleAccumulator -= 0.04

            -- Delta waktu di sini adalah waktu nyata sejak sample Record terakhir,
            -- bukan sejak Heartbeat terakhir. Jadi recordedDt tetap cocok dengan
            -- Position delta dan Velocity pada sample yang benar-benar direkam.
            local realDelta = math.max(now - lastSampleTime, 0)
            lastSampleTime = now

            local currentPos = root.Position
            local currentPathPosition = getVisualPathFootCenter(char, root, hum) or currentPos
            local currentRot = root.CFrame.LookVector

            local currentToolObj = char:FindFirstChildOfClass("Tool")
            local currentToolName = currentToolObj and currentToolObj.Name or nil

            -- Rekam state animasi Climb yang benar-benar sedang dimainkan.
            local recordedClimbTp = nil
            local recordedClimbSpeed = nil
            local recordedClimbWeight = nil
            local recordedClimbPhase = nil
            local activeRecordClimbAnimation = nil
            local isRecordingClimb = false

            if recordAnimator and climbAnimationIdForRecord then
                for _, track in ipairs(recordAnimator:GetPlayingAnimationTracks()) do
                    local trackAnimation = track.Animation
                    if trackAnimation and trackAnimation.AnimationId == climbAnimationIdForRecord then
                        recordedClimbTp = track.TimePosition
                        recordedClimbSpeed = track.Speed
                        recordedClimbWeight = track.WeightCurrent
                        activeRecordClimbAnimation = track
                        isRecordingClimb = true
                        break
                    end
                end
            end

            -- V27.5 RECORD CLIMB PHASE
            if activeRecordClimbAnimation then
                local animationLength = tonumber(activeRecordClimbAnimation.Length) or 0
                local animationSpeed = math.abs(tonumber(activeRecordClimbAnimation.Speed) or 0)

                if animationLength > 0 then
                    if not wasRecordingClimbAnimation
                        or climbPhaseAnimationId ~= climbAnimationIdForRecord
                    then
                        local initialTimePosition =
                            tonumber(activeRecordClimbAnimation.TimePosition) or 0
                        climbPhase =
                            (initialTimePosition % animationLength)
                            / animationLength
                        climbPhaseAnimationId = climbAnimationIdForRecord
                        wasRecordingClimbAnimation = true
                    else
                        climbPhase =
                            (climbPhase
                                + (animationSpeed * realDelta / animationLength))
                            % 1
                    end

                    recordedClimbPhase = climbPhase
                end
            else
                wasRecordingClimbAnimation = false
                climbPhaseAnimationId = nil
                climbPhase = 0
            end

            local humanoidState = hum:GetState()
            local stateName = humanoidState.Name
            local isJumpingState =
                humanoidState == Enum.HumanoidStateType.Jumping

            -- JUMP RECORD 1X: hanya frame pertama saat masuk Jumping yang
            -- diberi flag jump. State/velocity tetap direkam setiap frame.
            local isJump =
                isJumpingState
                and humanoidState == Enum.HumanoidStateType.Jumping
                and lastHumanoidState ~= Enum.HumanoidStateType.Jumping

            local stateChanged = humanoidState ~= lastHumanoidState
            local m1Changed = self.IsM1Down ~= lastM1
            local toolChanged = currentToolName ~= lastTool

            -- Timestamp bertambah pada setiap sample. State lama tetap dipertahankan
            -- untuk sinkronisasi Undo dan tidak dipakai untuk membuang frame.
            activeRecordTime += realDelta

            -- V28.5: audit sample menggunakan Dt + delta Position + Velocity.
            -- Ini hanya membersihkan spike posisi horizontal yang jelas tidak
            -- konsisten dengan gerakan normal. Climb sengaja tidak disentuh.
            local recordedPosition = currentPos
            local previousRecordedFrame = self.Frames[#self.Frames]
            local positionDeltaSpeed = 0
            local velocityMismatch = false
            local sampleClamped = false

            if previousRecordedFrame and realDelta > 0 and not isRecordingClimb then
                local previousPosition = Vector3.new(
                    tonumber(previousRecordedFrame.px) or currentPos.X,
                    tonumber(previousRecordedFrame.py) or currentPos.Y,
                    tonumber(previousRecordedFrame.pz) or currentPos.Z
                )

                local delta = currentPos - previousPosition
                local horizontalDelta = Vector3.new(delta.X, 0, delta.Z)
                positionDeltaSpeed = horizontalDelta.Magnitude / math.max(realDelta, 1 / 240)

                local rawVelocity = root.AssemblyLinearVelocity
                local horizontalVelocity = Vector3.new(
                    rawVelocity.X,
                    0,
                    rawVelocity.Z
                )
                local walkSpeedReference = math.max(
                    16,
                    tonumber(hum.WalkSpeed) or 16,
                    tonumber(previousRecordedFrame.walkSpeed) or 16
                )

                local velocityReference = math.max(
                    walkSpeedReference,
                    horizontalVelocity.Magnitude
                )

                local allowedHorizontalSpeed = math.max(
                    80,
                    velocityReference * 2.5 + 20
                )
                local allowedHorizontalDistance =
                    allowedHorizontalSpeed * realDelta + 0.75

                velocityMismatch =
                    positionDeltaSpeed > allowedHorizontalSpeed
                    and horizontalDelta.Magnitude > 3

                if velocityMismatch and horizontalDelta.Magnitude > allowedHorizontalDistance then
                    local safeHorizontal =
                        horizontalDelta.Unit * allowedHorizontalDistance
                    recordedPosition = Vector3.new(
                        previousPosition.X + safeHorizontal.X,
                        currentPos.Y,
                        previousPosition.Z + safeHorizontal.Z
                    )
                    sampleClamped = true
                end
            end

            table.insert(self.Frames, {
                t = activeRecordTime,
                hipHeight = hum.HipHeight,
                px = recordedPosition.X,
                py = recordedPosition.Y,
                pz = recordedPosition.Z,
                pathX = currentPathPosition.X,
                pathY = currentPathPosition.Y,
                pathZ = currentPathPosition.Z,
                vx = root.AssemblyLinearVelocity.X,
                vy = root.AssemblyLinearVelocity.Y,
                vz = root.AssemblyLinearVelocity.Z,
                avx = root.AssemblyAngularVelocity.X,
                avy = root.AssemblyAngularVelocity.Y,
                avz = root.AssemblyAngularVelocity.Z,
                lx = currentRot.X,
                ly = currentRot.Y,
                lz = currentRot.Z,
                mdx = hum.MoveDirection.X,
                mdy = hum.MoveDirection.Y,
                mdz = hum.MoveDirection.Z,
                jump = isJump,
                rawJump = isJump,
                stateChanged = stateChanged,
                recordedDt = realDelta,
                positionDeltaSpeed = positionDeltaSpeed,
                velocityMismatch = velocityMismatch,
                sampleClamped = sampleClamped,
                walkSpeed = tonumber(hum.WalkSpeed) or 16,
                rawState = stateName,
                humanoidState = stateName,
                stateValue = (Enum.HumanoidStateType[stateName] and Enum.HumanoidStateType[stateName].Value) or humanoidState.Value,
                tool = currentToolName,
                m1 = self.IsM1Down,
                climbTp = recordedClimbTp,
                climbSpeed = recordedClimbSpeed,
                climbWeight = recordedClimbWeight,
                climbPhase = recordedClimbPhase
            })

            if self.ShowPath and self.PathFolder then
                local pathStart = self.RecordLastPosition or currentPathPosition
                self:DrawLine(pathStart, currentPathPosition)
            end

            self.RecordLastPosition = currentPathPosition
            lastPos = currentPos
            lastRot = currentRot
            lastM1 = self.IsM1Down
            lastTool = currentToolName
            lastHumanoidState = humanoidState
        end)
    )
end

function MacroEngine:UndoRecord(frameCount)
    if self.State ~= "Recording" then
        return false, "Undo hanya bisa saat RECORD aktif."
    end

    frameCount = math.clamp(tonumber(frameCount) or 10, 10, 40)
    local frameTotal = #self.Frames
    if frameTotal <= 1 then
        return false, "Belum ada frame yang bisa dihapus."
    end

    local removeCount = math.min(frameCount, frameTotal - 1)

    for _ = 1, removeCount do
        if #self.Frames > 1 then
            table.remove(self.Frames)
        end
    end

    -- Setelah UNDO, waktu dan indeks playback selalu diarahkan ke frame terakhir
    -- yang masih tersisa agar karakter mengikuti hasil rekaman terbaru.
    local lastIndex = #self.Frames
    local lastFrame = self.Frames[lastIndex]
    self.CurrentTime = (lastFrame and lastFrame.t) or 0
    self.PlaybackIndex = math.max(1, lastIndex)

    -- Pindahkan karakter ke frame terakhir yang tersisa secara langsung.
    -- Ini dilakukan setiap kali UNDO, bukan hanya ketika frame lompatan terhapus.
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    if lastFrame and root then
        local pos = Vector3.new(lastFrame.px, lastFrame.py, lastFrame.pz)
        local look = Vector3.new(
            lastFrame.lx or root.CFrame.LookVector.X,
            lastFrame.ly or root.CFrame.LookVector.Y,
            lastFrame.lz or root.CFrame.LookVector.Z
        )
        if look.Magnitude < 0.001 then
            look = root.CFrame.LookVector
        end

        pcall(function()
            root.CFrame = CFrame.lookAt(pos, pos + look.Unit)
            -- Sinkronkan ujung VisualPath dengan frame terakhir setelah UNDO.
            self.RecordLastPosition = Vector3.new(
                tonumber(lastFrame.pathX) or pos.X,
                tonumber(lastFrame.pathY) or pos.Y,
                tonumber(lastFrame.pathZ) or pos.Z
            )
            -- Pertahankan velocity/state dari frame terakhir. Jangan paksa Running,
            -- karena frame terakhir bisa saja Jumping, Freefall, Climbing, dll.
            if hum then
                local vx = tonumber(lastFrame.vx) or 0
                local vy = tonumber(lastFrame.vy) or 0
                local vz = tonumber(lastFrame.vz) or 0
                local avx = tonumber(lastFrame.avx) or 0
                local avy = tonumber(lastFrame.avy) or 0
                local avz = tonumber(lastFrame.avz) or 0
                root.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
                root.AssemblyAngularVelocity = Vector3.new(avx, avy, avz)
            end
        end)
    end

    -- VisualPath ikut dipotong sesuai frame yang masih tersisa.
    -- Render dilakukan setelah teleport agar ujung garis tepat di frame terakhir.
    if self.ShowPath then
        self:RenderPath(#self.Frames)
    end

    -- Beri sinyal ke Heartbeat Record() untuk mengadopsi frame terakhir
    -- sebagai baseline baru sebelum mengambil sample berikutnya.
    self._RecordSyncVersion = (self._RecordSyncVersion or 0) + 1

    return true, string.format("Undo: %d frame dihapus, karakter dipindahkan ke frame terakhir", removeCount)
end

function MacroEngine:Play()
    if #self.Frames == 0 then return end
    if self.State == "Playing" then return end
    if self.State == "Paused" then
        self.State = "Playing"
        return
    end

    local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local root = char:WaitForChild("HumanoidRootPart")
    local hum = char:WaitForChild("Humanoid")

    -- Jika STOP sebelumnya menyimpan pose Climb terakhir, lepaskan pose
    -- tersebut sebelum playback baru dimulai agar tidak terbawa ke route.
    clearFrozenClimbPose()
    pcall(function()
        local oldChar = LocalPlayer.Character
        local oldAnimate = oldChar and oldChar:FindFirstChild("Animate")
        if oldAnimate then
            oldAnimate.Disabled = false
        end
    end)

    self:CleanUp()
    self.State = "Playing"

    -- Start sama seperti baseline: cari frame yang paling dekat dengan posisi karakter.
    local nearestIndex = 1
    local nearestDistance = math.huge
    local startPosition = root.Position

    for i, frame in ipairs(self.Frames) do
        local px = tonumber(frame.px)
        local py = tonumber(frame.py)
        local pz = tonumber(frame.pz)
        if px and py and pz then
            local dx = px - startPosition.X
            local dy = py - startPosition.Y
            local dz = pz - startPosition.Z
            local d2 = dx * dx + dy * dy + dz * dz
            if d2 < nearestDistance then
                nearestDistance = d2
                nearestIndex = i
            end
        end
    end

    self.PlaybackIndex = math.clamp(nearestIndex, 1, #self.Frames)
    self.CurrentTime = tonumber(self.Frames[self.PlaybackIndex].t) or 0
    self.LastPlaybackFrameIndex = self.PlaybackIndex
    self.LastM1State = false
    self.IsLoopWaiting = false
    self._PlaybackJumpPhase = false
    self._LastPlaybackHumanoidState = nil

    local firstFrame = self.Frames[self.PlaybackIndex]
    local firstTarget = Vector3.new(
        tonumber(firstFrame.px) or root.Position.X,
        tonumber(firstFrame.py) or root.Position.Y,
        tonumber(firstFrame.pz) or root.Position.Z
    )

    local recordHip = tonumber(firstFrame.hipHeight)
    local playHip = tonumber(hum.HipHeight)
    if recordHip and playHip then
        firstTarget += Vector3.new(0, playHip - recordHip, 0)
    end

    -- AUTO ROUTE: metode diganti mengikuti pola kompetitor.
    -- Tool sudah harus ter-equip sebelum speed route dibaca, sehingga
    -- WalkSpeed dari coil/tool menjadi speed lari menuju route.
    local function equipTool(toolName)
        local currentTool = char:FindFirstChildOfClass("Tool")
        if toolName then
            if not currentTool or currentTool.Name ~= toolName then
                local target = LocalPlayer.Backpack:FindFirstChild(toolName)
                if target then
                    pcall(function() hum:EquipTool(target) end)
                end
            end
        elseif currentTool then
            pcall(function() hum:UnequipTools() end)
        end
    end

    equipTool(firstFrame.tool)

    -- Beri satu kesempatan singkat agar Equipped/tool script menerapkan WalkSpeed.
    task.wait()

    -- AUTO ROUTE SPEED: gunakan WalkSpeed yang direkam di route.
    -- Tool tetap di-equip seperti sebelumnya, tetapi speed approach tidak lagi
    -- bergantung pada WalkSpeed Tool saat ini. Speed mengikuti data record.
    local function getAutoRouteRecordedSpeed(index, fallback)
        local frame = self.Frames[math.clamp(tonumber(index) or self.PlaybackIndex, 1, #self.Frames)]
        local recordedSpeed = frame and tonumber(frame.walkSpeed) or nil
        if recordedSpeed and recordedSpeed > 2 then
            return recordedSpeed
        end
        return fallback or tonumber(self.Speed) or 16
    end

    local autoRouteRunSpeed = getAutoRouteRecordedSpeed(
        self.PlaybackIndex,
        tonumber(hum.WalkSpeed) or 16
    )

    local AUTO_ROUTE_STOP_DISTANCE = 3.5
    local AUTO_ROUTE_ACCEPT_MULTIPLIER = 1.65
    local AUTO_ROUTE_OVERSHOOT_MULTIPLIER = 2.4
    local AUTO_ROUTE_LOOKAHEAD_FRAMES = 8
    local AUTO_ROUTE_STUCK_SECONDS = 0.85
    local AUTO_ROUTE_STUCK_MIN_MOVE = 0.75
    local AUTO_ROUTE_RETARGET_SECONDS = 0.35

    local function framePosition(index, fallback)
        local frame = self.Frames[index]
        if not frame then return fallback end
        local pos = Vector3.new(
            tonumber(frame.px) or fallback.X,
            tonumber(frame.py) or fallback.Y,
            tonumber(frame.pz) or fallback.Z
        )
        local recordHipValue = tonumber(frame.hipHeight)
        local currentHipValue = tonumber(hum.HipHeight)
        if recordHipValue and currentHipValue then
            pos += Vector3.new(0, currentHipValue - recordHipValue, 0)
        end
        return pos
    end

    local routeTargetIndex = math.clamp(
        self.PlaybackIndex + AUTO_ROUTE_LOOKAHEAD_FRAMES,
        1,
        math.max(1, #self.Frames - 1)
    )
    local routeTarget = framePosition(routeTargetIndex, firstTarget)
    local approachDistance = (routeTarget - root.Position).Magnitude
    local approachActive = approachDistance > AUTO_ROUTE_STOP_DISTANCE
    local approachElapsed = 0
    local approachStartClock = os.clock()
    local approachLastRetarget = 0
    local approachBestDistance = math.huge
    local approachLastProgressPosition = root.Position
    local approachLastProgressClock = os.clock()
    local approachLastDirection = nil
    local approachMaxTime = math.max(12, (approachDistance / math.max(autoRouteRunSpeed, 1)) + 4)

    local oldWalkSpeed = hum.WalkSpeed
    local oldAutoRotate = hum.AutoRotate
    local oldUseJumpPower = hum.UseJumpPower
    local oldJumpPower = hum.JumpPower
    local oldJumpHeight = hum.JumpHeight
    local oldPlatformStand = hum.PlatformStand

    self._PlaybackRestore = {
        Humanoid = hum,
        Root = root,
        WalkSpeed = oldWalkSpeed,
        AutoRotate = oldAutoRotate,
        UseJumpPower = oldUseJumpPower,
        JumpPower = oldJumpPower,
        JumpHeight = oldJumpHeight,
        PlatformStand = oldPlatformStand
    }

    hum.AutoRotate = false
    hum.PlatformStand = false

    -- Playback normal tetap sederhana: timestamp menentukan frame A/B,
    -- lalu Position + Rotation diinterpolasikan langsung.
    local function clampMagnitude(v, maxMag)
        if v.Magnitude > maxMag then
            return v.Unit * maxMag
        end
        return v
    end

    local function angleDelta(a, b)
        return math.atan2(math.sin(b - a), math.cos(b - a))
    end

    local function getYaw(frame, fallback)
        local yaw = tonumber(frame and frame.rotation)
        if yaw ~= nil then return yaw end
        local lx = tonumber(frame and frame.lx) or 0
        local lz = tonumber(frame and frame.lz) or 0
        if math.abs(lx) > 0.000001 or math.abs(lz) > 0.000001 then
            return math.atan2(-lx, -lz)
        end
        return fallback or 0
    end

    local function stateFromValue(value)
        value = tonumber(value)
        if not value then return nil end
        for _, item in ipairs(Enum.HumanoidStateType:GetEnumItems()) do
            if item.Value == value then return item end
        end
        return nil
    end

    -- V28.2: tahap normalisasi internal bergaya Onium.
    -- Frame Record kita sudah mempunyai format yang stabil, jadi tahap ini
    -- tidak mengubah data; ia hanya membentuk representasi playback yang sama:
    -- pos + city/velocity + walkSpeed + rawState/rawJump + flags.
    local function normalizePlaybackFrame(frame, fallbackPos)
        fallbackPos = fallbackPos or root.Position
        if type(frame) ~= "table" then
            return {
                t = 0,
                pos = fallbackPos,
                city = Vector3.zero,
                velocity = 0,
                walkSpeed = hum.WalkSpeed,
                moveDirection = Vector3.zero,
                rawState = "Running",
                rawJump = false,
                climbing = false,
                jumping = false,
                freefall = false,
                sitting = false,
                swimming = false,
                state = "Running"
            }
        end

        local pos = Vector3.new(
            tonumber(frame.px) or fallbackPos.X,
            tonumber(frame.py) or fallbackPos.Y,
            tonumber(frame.pz) or fallbackPos.Z
        )

        local city = Vector3.new(
            tonumber(frame.vx) or 0,
            tonumber(frame.vy) or 0,
            tonumber(frame.vz) or 0
        )

        local stateName = tostring(frame.state or "")
        if stateName == "" then
            local enumState = stateFromValue(frame.stateValue)
            stateName = enumState and enumState.Name or tostring(frame.humanoidState or "Running")
        end
        stateName = stateName:gsub("Enum%.HumanoidStateType%.", "")

        local rawState = tostring(frame.rawState or frame.humanoidState or stateName)
        rawState = rawState:gsub("Enum%.HumanoidStateType%.", "")

        local rawJump =
            frame.rawJump == true
            or frame.originalJump == true
            or frame.jump == true

        local jumping =
            rawJump
            or rawState == "Jumping"
            or rawState == "Freefall"
            or rawState == "FallingDown"

        local moveDirection = Vector3.new(
            tonumber(frame.mdx) or 0,
            tonumber(frame.mdy) or 0,
            tonumber(frame.mdz) or 0
        )

        return {
            t = tonumber(frame.t) or 0,
            pos = pos,
            city = city,
            velocity = Vector3.new(city.X, 0, city.Z).Magnitude,
            walkSpeed = tonumber(frame.walkSpeed) or hum.WalkSpeed,
            moveDirection = moveDirection,
            hipHeight = tonumber(frame.hipHeight),
            rawState = rawState,
            rawJump = rawJump,
            climbing = stateName == "Climbing",
            jumping = jumping,
            freefall = stateName == "Freefall" or stateName == "FallingDown",
            sitting = stateName == "Seated" or stateName == "Sitting",
            swimming = stateName == "Swimming",
            state = stateName
        }
    end

    local function playbackSmoothStep(alpha)
        alpha = math.clamp(tonumber(alpha) or 0, 0, 1)
        return alpha * alpha * (3 - (2 * alpha))
    end

    local function releaseMouse()
        if self.LastM1State then
            pcall(function()
                VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 1)
            end)
            self.LastM1State = false
        end
    end

    local function equipTool(toolName)
        local currentTool = char:FindFirstChildOfClass("Tool")
        if toolName then
            if not currentTool or currentTool.Name ~= toolName then
                local target = LocalPlayer.Backpack:FindFirstChild(toolName)
                if target then
                    pcall(function() hum:EquipTool(target) end)
                end
            end
        elseif currentTool then
            pcall(function() hum:UnequipTools() end)
        end
    end

    local function restoreController()
        releaseMouse()
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero

            hum.AutoRotate = oldAutoRotate
            hum.PlatformStand = oldPlatformStand
            hum.UseJumpPower = oldUseJumpPower
            hum.JumpPower = oldJumpPower
            hum.JumpHeight = oldJumpHeight
            hum.WalkSpeed = oldWalkSpeed
        end)
        self._PlaybackRestore = nil
    end

    table.insert(self.Bin, RunService.Heartbeat:Connect(function(dt)
        if hum.Health <= 0 or not char.Parent or not root.Parent then
            restoreController()
            self.State = "Idle"
            self:CleanUp()
            return
        end

        dt = math.clamp(dt, 1 / 240, 0.12)
        self.LastPlaybackPosition = root.Position
        self.LastPlaybackFrameIndex = self.PlaybackIndex

        -- AUTO ROUTE: lari ke route dengan speed Tool/Playback yang stabil.
        -- Target memakai lookahead + retarget, bukan easing/gain berbasis jarak.
        if approachActive then
            approachElapsed += dt

            local currentPos = root.Position

            -- Retarget berkala seperti metode kompetitor.
            if os.clock() - approachLastRetarget >= AUTO_ROUTE_RETARGET_SECONDS then
                approachLastRetarget = os.clock()

                local nearestIndex = self.PlaybackIndex
                local nearestDistance = math.huge
                for i, frame in ipairs(self.Frames) do
                    local px = tonumber(frame.px)
                    local py = tonumber(frame.py)
                    local pz = tonumber(frame.pz)
                    if px and py and pz then
                        local dx = px - currentPos.X
                        local dy = py - currentPos.Y
                        local dz = pz - currentPos.Z
                        local d2 = dx * dx + dy * dy + dz * dz
                        if d2 < nearestDistance then
                            nearestDistance = d2
                            nearestIndex = i
                        end
                    end
                end

                nearestDistance = math.sqrt(nearestDistance)
                nearestIndex = math.clamp(nearestIndex, 1, math.max(1, #self.Frames - 1))

                local acceptDistance = math.max(
                    AUTO_ROUTE_STOP_DISTANCE,
                    AUTO_ROUTE_STOP_DISTANCE * AUTO_ROUTE_ACCEPT_MULTIPLIER
                )

                if nearestDistance <= acceptDistance then
                    -- Posisi aktual menjadi sumber baru untuk menentukan titik mulai.
                    self.PlaybackIndex = nearestIndex
                    self.CurrentTime = tonumber(self.Frames[nearestIndex].t) or self.CurrentTime
                    approachActive = false
                    approachElapsed = 0
                    root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                    root.AssemblyAngularVelocity = Vector3.zero
                    return
                end

                if nearestIndex >= routeTargetIndex or nearestDistance + 2 < approachBestDistance then
                    routeTargetIndex = math.clamp(
                        nearestIndex + AUTO_ROUTE_LOOKAHEAD_FRAMES,
                        1,
                        math.max(1, #self.Frames - 1)
                    )
                    routeTarget = framePosition(routeTargetIndex, routeTarget)
                end

                -- Ikuti speed hasil record di sekitar titik route yang sedang
                -- didekati. Ini membuat Auto Run menyesuaikan speed route
                -- tanpa memakai speed berdasarkan jarak.
                autoRouteRunSpeed = getAutoRouteRecordedSpeed(
                    routeTargetIndex,
                    autoRouteRunSpeed
                )
            end

            local flatTarget = Vector3.new(routeTarget.X, currentPos.Y, routeTarget.Z)
            local delta = flatTarget - currentPos
            local dist = delta.Magnitude

            if dist < approachBestDistance then
                approachBestDistance = dist
                approachLastProgressPosition = currentPos
                approachLastProgressClock = os.clock()
            end

            local acceptDistance = math.max(
                AUTO_ROUTE_STOP_DISTANCE,
                AUTO_ROUTE_STOP_DISTANCE * AUTO_ROUTE_ACCEPT_MULTIPLIER
            )
            local overshootDistance = math.max(
                acceptDistance + 1,
                AUTO_ROUTE_STOP_DISTANCE * AUTO_ROUTE_OVERSHOOT_MULTIPLIER
            )

            -- Sudah cukup dekat: jangan dipaksa tepat 0 stud.
            if dist <= acceptDistance then
                self.PlaybackIndex = math.clamp(routeTargetIndex, 1, #self.Frames)
                self.CurrentTime = tonumber(self.Frames[self.PlaybackIndex].t) or self.CurrentTime
                approachActive = false
                approachElapsed = 0
                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                root.AssemblyAngularVelocity = Vector3.zero
                return
            end

            -- Jika target sudah terlewati, jangan berbalik mengejar target lama.
            if approachLastDirection and delta.Magnitude > 0.01 then
                local nowDirection = delta.Unit
                if approachLastDirection:Dot(nowDirection) < -0.15
                    and approachBestDistance <= overshootDistance then
                    approachActive = false
                    approachElapsed = 0
                    self.PlaybackIndex = math.clamp(routeTargetIndex, 1, #self.Frames)
                    self.CurrentTime = tonumber(self.Frames[self.PlaybackIndex].t) or self.CurrentTime
                    root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                    root.AssemblyAngularVelocity = Vector3.zero
                    return
                end
            end

            -- Anti-stuck.
            if os.clock() - approachLastProgressClock >= AUTO_ROUTE_STUCK_SECONDS then
                local moved = (currentPos - approachLastProgressPosition).Magnitude
                if moved <= AUTO_ROUTE_STUCK_MIN_MOVE
                    or approachBestDistance <= overshootDistance * 1.75 then
                    approachActive = false
                    approachElapsed = 0
                    self.PlaybackIndex = math.clamp(routeTargetIndex, 1, #self.Frames)
                    self.CurrentTime = tonumber(self.Frames[self.PlaybackIndex].t) or self.CurrentTime
                    root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                    root.AssemblyAngularVelocity = Vector3.zero
                    return
                end
                approachLastProgressPosition = currentPos
                approachLastProgressClock = os.clock()
            end

            if os.clock() - approachStartClock > approachMaxTime then
                approachActive = false
                approachElapsed = 0
                self.PlaybackIndex = math.clamp(routeTargetIndex, 1, #self.Frames)
                self.CurrentTime = tonumber(self.Frames[self.PlaybackIndex].t) or self.CurrentTime
                root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
                root.AssemblyAngularVelocity = Vector3.zero
                return
            end

            local dir = dist > 0.001 and delta.Unit or Vector3.zero
            approachLastDirection = dir

            pcall(function()
                hum.AutoRotate = true
                hum.PlatformStand = false
                hum.Sit = false
                hum.Jump = false
                hum:Move(dir, false)

                -- Speed mengikuti WalkSpeed hasil record route.
                -- Tidak ada speed scaling berdasarkan jarak.
                hum.WalkSpeed = autoRouteRunSpeed

                if dir.Magnitude > 0.01 then
                    root.CFrame = CFrame.lookAt(
                        root.Position,
                        root.Position + Vector3.new(dir.X, 0, dir.Z)
                    )
                end

                root.AssemblyLinearVelocity = Vector3.new(
                    dir.X * autoRouteRunSpeed,
                    root.AssemblyLinearVelocity.Y,
                    dir.Z * autoRouteRunSpeed
                )
            end)

            return
        end

        -- V25: PLAYBACK SEDERHANA / TIME = TIME RECORD
        -- Tidak ada frame-lock, catch-up tambahan, sanitizer posisi, atau
        -- pengali/pengurang speed. CurrentTime hanya berjalan mengikuti dt
        -- playback dan posisi diinterpolasikan dari Position JSON.
        local count = #self.Frames
        local playbackSpeed = math.max(0, tonumber(self.Speed) or 1)

        if count > 1 then
            self.CurrentTime += math.max(0, dt) * playbackSpeed

            local firstTime = tonumber(self.Frames[1].t) or 0
            local lastTime = tonumber(self.Frames[count].t) or firstTime
            self.CurrentTime = math.clamp(self.CurrentTime, firstTime, lastTime)
        end

        local lastFrame = self.Frames[count]
        local lastTime = tonumber(lastFrame.t) or 0

        if self.CurrentTime >= lastTime then
            if self.LoopEnabled then
                releaseMouse()
                if self.LoopDelay > 0 then
                    if not self.IsLoopWaiting then
                        self.IsLoopWaiting = true
                        self.LoopWaitStartTime = os.clock()
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    elseif os.clock() - self.LoopWaitStartTime >= self.LoopDelay then
                        self.IsLoopWaiting = false
                        self.PlaybackIndex = 1
                        self.CurrentTime = 0
                        self._PlaybackSegmentIndex = nil
                        self._PlaybackSegmentAlpha = 0
                    end
                    return
                end
                self.PlaybackIndex = 1
                self.CurrentTime = 0
                self._PlaybackSegmentIndex = nil
                self._PlaybackSegmentAlpha = 0
            else
                restoreController()
                self.State = "Idle"
                self:CleanUp()
                return
            end
        end

        -- PLAYBACK V28: cari frame A/B berdasarkan timestamp dengan binary search.
        -- Ini mengikuti pola time-driven: CurrentTime -> A/B -> alpha -> Position.
        local i = math.clamp(self.PlaybackIndex or 1, 1, count)
        if count > 1 then
            local left = 1
            local right = count - 1
            while left <= right do
                local mid = math.floor((left + right) / 2)
                local midTime = tonumber(self.Frames[mid].t) or 0
                local nextTime = tonumber(self.Frames[mid + 1].t) or midTime
                if self.CurrentTime < midTime then
                    right = mid - 1
                elseif self.CurrentTime >= nextTime then
                    left = mid + 1
                else
                    i = mid
                    break
                end
            end
            if left > right then
                i = math.clamp(left, 1, count - 1)
            end
            self.PlaybackIndex = i
        end

        local a = self.Frames[i]
        local b = self.Frames[math.min(i + 1, count)] or a

        local t0 = tonumber(a.t) or 0
        local t1 = tonumber(b.t) or t0
        local segment = math.max(t1 - t0, 1 / 240)
        local u = math.clamp((self.CurrentTime - t0) / segment, 0, 1)
        -- Gunakan interpolasi posisi langsung dari frame rekaman.
        -- Velocity JSON tetap dipakai sebagai informasi gerakan/state,
        -- tetapi tidak dipakai sebagai tangent Hermite karena tangent yang
        -- terlalu besar (terutama vy saat Freefall) dapat membuat karakter
        -- tertarik, overshoot, lalu kembali naik.
        local p0 = Vector3.new(
            tonumber(a.px) or root.Position.X,
            tonumber(a.py) or root.Position.Y,
            tonumber(a.pz) or root.Position.Z
        )
        local p1 = Vector3.new(
            tonumber(b.px) or p0.X,
            tonumber(b.py) or p0.Y,
            tonumber(b.pz) or p0.Z
        )

        -- V25: Position adalah sumber kebenaran route.
        -- Tidak ada penambahan/pengurangan speed dan tidak ada sanitizer
        -- yang mengubah posisi record. Velocity JSON tetap disimpan dan
        -- dipakai apa adanya sebagai informasi gerakan.
        local rawClimbP1 = p1
        local rawClimbTargetPosition = p0:Lerp(rawClimbP1, u)
        local rawClimbDesiredVelocity = (rawClimbP1 - p0) / segment

        local targetPosition = p0:Lerp(p1, u)

        -- Velocity route mentah hanya untuk sinyal Humanoid/Animate.
        -- Tidak dihitung ulang dari posisi dan tidak diberi multiplier.
        local recordedVelocity = Vector3.new(
            tonumber(a.vx) or 0,
            tonumber(a.vy) or 0,
            tonumber(a.vz) or 0
        )

        local recordHip = tonumber(a.hipHeight)
        local currentHip = tonumber(hum.HipHeight)
        if recordHip and currentHip then
            targetPosition += Vector3.new(0, currentHip - recordHip, 0)
        end

        equipTool(a.tool)
        if a.walkSpeed ~= nil then
            pcall(function() hum.WalkSpeed = tonumber(a.walkSpeed) or hum.WalkSpeed end)
        end

        local moveDirection = Vector3.new(
            tonumber(a.mdx) or 0,
            tonumber(a.mdy) or 0,
            tonumber(a.mdz) or 0
        )
        local playbackState = stateFromValue(a.stateValue)

        -- V27.14: jangan pre-apply Running/Landed saat keluar dari Fall.
        -- State playback tetap diproses setelah route Position/Velocity dipasang,
        -- sehingga Humanoid tidak sempat melakukan koreksi grounding yang dapat
        -- menarik karakter sebelum frame fall/landing selesai.

        local normalPlaybackStateApplied = false

        -- CLIMB PLAYBACK PRESISI:
        -- Climb menggunakan metode yang sama-sama berbasis TARGET POSITION
        -- seperti playback route/jump, bukan controller velocity + tracking gain.
        -- Ini mencegah physics Humanoid dan velocity climb saling menarik dengan
        -- posisi record sehingga karakter terasa berat, overshoot, atau keluar rute.
        local isClimbState =
            playbackState == Enum.HumanoidStateType.Climbing
            or tostring(a.state or ""):lower() == "climbing"

        if isClimbState then
            -- V28.9: METODE CLIMB KOMPETITOR.
            pcall(function()
                hum:ChangeState(Enum.HumanoidStateType.Climbing)
            end)

            local climbVerticalSpeed = math.abs(rawClimbDesiredVelocity.Y)
            playClimbAnimation(
                char,
                hum,
                climbVerticalSpeed
            )

            local climbYaw0 = getYaw(a, 0)
            local climbYaw1 = getYaw(b, climbYaw0)
            local climbYaw = climbYaw0 + angleDelta(climbYaw0, climbYaw1) * u

            local timeDiff = math.max(
                (tonumber(b.t) or 0) - (tonumber(a.t) or 0),
                1 / 240
            )

            -- Kompetitor mengambil velocity dari frame B sebagai mapVel.
            -- Jika velocity record kosong, gunakan velocity dari delta posisi.
            local climbRecordedVelocity = Vector3.new(
                tonumber(b.vx) or 0,
                tonumber(b.vy) or 0,
                tonumber(b.vz) or 0
            )

            local climbPositionVelocity = (p1 - p0) / timeDiff

            if climbRecordedVelocity.Magnitude < 0.05 then
                climbRecordedVelocity = climbPositionVelocity
            end

            local climbHorizontal = Vector3.new(
                climbRecordedVelocity.X,
                0,
                climbRecordedVelocity.Z
            )

            local climbVertical = math.clamp(
                climbRecordedVelocity.Y,
                -50,
                50
            )

            pcall(function()
                root.CFrame =
                    CFrame.new(rawClimbTargetPosition)
                    * CFrame.Angles(0, climbYaw, 0)

                root.AssemblyLinearVelocity = Vector3.new(
                    climbHorizontal.X * 0.25,
                    climbVertical,
                    climbHorizontal.Z * 0.25
                )
                root.AssemblyAngularVelocity = Vector3.zero

                hum.AutoRotate = false
                hum.PlatformStand = false
                hum.Sit = false
                hum:Move(Vector3.zero, false)
            end)

            self._LastPlaybackHumanoidState =
                Enum.HumanoidStateType.Climbing

        else
            -- V28.2 NORMAL PLAYBACK:
            -- Satukan tahap yang memang dipakai Onium + KacungMarv untuk RUNNING:
            --   1) normalisasi frame -> pos/city/walkSpeed/state
            --   2) smooth alpha
            --   3) Position tetap route authority
            --   4) mapVel = recorded/city velocity
            --   5) posDeltaVel = velocity dari route
            --   6) mapVel diberi horizontal safety cap
            --   7) MoveDirection mengikuti frame
            -- Jump dan Climb tetap memakai metode Boneto sebelumnya.
            if self._LastPlaybackHumanoidState == Enum.HumanoidStateType.Climbing
                or activeClimbTrack
            then
                stopClimbPresentation(char)
            end

            local oa = normalizePlaybackFrame(a, root.Position)
            local ob = normalizePlaybackFrame(b, oa.pos)

            local eased = playbackSmoothStep(u)
            local targetPos = oa.pos:Lerp(ob.pos, eased)

            -- HipHeight correction Onium/KacungMarv.
            local recHip = tonumber(ob.hipHeight) or tonumber(oa.hipHeight)
            local curHip = tonumber(hum.HipHeight)
            if recHip and curHip and recHip > 0 and curHip > 0 then
                local yFix = curHip - recHip
                if math.abs(yFix) <= 8 then
                    targetPos = Vector3.new(targetPos.X, targetPos.Y + yFix, targetPos.Z)
                end
            end

            local mapVel = oa.city:Lerp(ob.city, eased)
            local segmentTime = math.max(t1 - t0, 0.001)
            local posDeltaVel = (ob.pos - oa.pos) / segmentTime

            local moveDir = oa.moveDirection:Lerp(ob.moveDirection, eased)

            -- V28.4: tentukan lebih dulu apakah segment ini benar-benar
            -- Jump/Freefall. Normal Running tidak boleh mengambil alih state
            -- pada segment udara.
            local rawStateA = tostring(oa.rawState or oa.state or "")
                :gsub("Enum%.HumanoidStateType%.", "")
            local rawStateB = tostring(ob.rawState or ob.state or "")
                :gsub("Enum%.HumanoidStateType%.", "")

            local segmentIsJumping =
                oa.rawJump
                or ob.rawJump
                or rawStateA == "Jumping"
                or rawStateB == "Jumping"
                or rawStateA == "Freefall"
                or rawStateB == "Freefall"
                or rawStateA == "FallingDown"
                or rawStateB == "FallingDown"

            -- Safety cap hanya untuk NORMAL running.
            -- Position tetap menjadi route authority.
            local horizontalA = Vector3.new(oa.city.X, 0, oa.city.Z).Magnitude
            local horizontalB = Vector3.new(ob.city.X, 0, ob.city.Z).Magnitude
            local baseFrameSpeed = math.max(
                tonumber(oa.walkSpeed) or 0,
                tonumber(ob.walkSpeed) or 0,
                playbackSpeed,
                16
            )
            local maxLoopSafeSpeed = math.max(baseFrameSpeed * 1.12, 16)

            local hVel = Vector3.new(mapVel.X, 0, mapVel.Z)
            if hVel.Magnitude > maxLoopSafeSpeed and hVel.Magnitude > 0 then
                hVel = hVel.Unit * maxLoopSafeSpeed
            end

            local yVel = math.clamp(mapVel.Y, -80, 80)

            local yaw0 = getYaw(a, 0)
            local yaw1 = getYaw(b, yaw0)
            local yaw = yaw0 + angleDelta(yaw0, yaw1) * eased

            pcall(function()
                -- Route authority tetap sama: CFrame langsung ke target route.
                root.CFrame =
                    CFrame.new(targetPos)
                    * CFrame.Angles(0, yaw, 0)

                if moveDir.Magnitude > 0.01 then
                    hum:Move(moveDir.Unit, true)
                else
                    hum:Move(Vector3.zero, false)
                end

                if not segmentIsJumping then
                    -- Normal RUNNING: velocity hanya support.
                    -- Batasi berdasarkan WalkSpeed, bukan raw velocity spike.
                    root.AssemblyLinearVelocity =
                        Vector3.new(hVel.X, yVel, hVel.Z)
                    root.AssemblyAngularVelocity = Vector3.zero

                    -- Pertahankan Running berdasarkan movement yang direkam, bukan hanya
                    -- velocity hasil interpolasi yang bisa sesaat turun ke 0.
                    -- Ini mencegah flicker Running <-> Standing yang terlihat seperti Idle.
                    local recordedMoveMagnitude = moveDir.Magnitude
                    local recordedHorizontalMotion = hVel.Magnitude
                    local isRecordedMoving =
                        recordedMoveMagnitude > 0.08
                        or recordedHorizontalMotion > 0.45
                        or oa.state == "Running"
                        or ob.state == "Running"

                    local normalState =
                        isRecordedMoving
                        and Enum.HumanoidStateType.Running
                        or Enum.HumanoidStateType.Standing

                    if normalState ~= self._LastPlaybackHumanoidState then
                        hum:ChangeState(normalState)
                        self._LastPlaybackHumanoidState = normalState
                    end

                    normalPlaybackStateApplied = true
                end
            end)
        end

        -- JUMP PRESISI / ANTI-FALSE-FREEFALL
        -- Jangan memakai a.jump sebagai trigger dan jangan membuat Jumping
        -- berulang-ulang. State tetap berasal dari rekaman, tetapi Freefall
        -- yang muncul sesaat ketika karakter masih berada pada fase naik
        -- diabaikan. Ini penting ketika jump dilakukan sangat cepat/spam.
        local stateEnum = playbackState

        local recordedVy0 = tonumber(a.vy)
        local recordedVy1 = tonumber(b.vy)
        local recordedVyNow = nil
        if recordedVy0 ~= nil and recordedVy1 ~= nil then
            recordedVyNow = recordedVy0 + (recordedVy1 - recordedVy0) * u
        else
            recordedVyNow = recordedVy0 or recordedVy1 or 0
        end

        local recordedY0 = tonumber(a.py)
        local recordedY1 = tonumber(b.py)
        local recordedYDelta = nil
        if recordedY0 ~= nil and recordedY1 ~= nil then
            recordedYDelta = recordedY1 - recordedY0
        end

        local isRecordedJump =
            stateEnum == Enum.HumanoidStateType.Jumping
            or self._LastPlaybackHumanoidState == Enum.HumanoidStateType.Jumping

        local isRecordedFreefall =
            stateEnum == Enum.HumanoidStateType.Freefall
            or stateEnum == Enum.HumanoidStateType.FallingDown

        -- Roblox kadang mengirim Freefall 1 frame lebih cepat daripada
        -- lintasan rekaman. Selama vy masih positif (naik), atau posisi antar
        -- frame masih naik, pertahankan Jumping. Begitu benar-benar mulai turun,
        -- barulah Freefall boleh mengambil alih.
        if isRecordedFreefall and isRecordedJump then
            local stillAscending =
                (recordedVyNow ~= nil and recordedVyNow > 0.05)
                or (recordedYDelta ~= nil and recordedYDelta > 0.001)

            -- Jangan mempromosikan Freefall kembali menjadi Jumping setelah
            -- playback sudah memasuki fase udara. Velocity tetap diterapkan,
            -- tetapi tidak boleh membuat transisi Jumping kedua.
            if stillAscending
                and self._LastPlaybackHumanoidState ~= Enum.HumanoidStateType.Jumping
                and self._LastPlaybackHumanoidState ~= Enum.HumanoidStateType.Freefall
            then
                stateEnum = Enum.HumanoidStateType.Jumping
            end
        elseif stateEnum == Enum.HumanoidStateType.Freefall
            and recordedVyNow ~= nil
            and recordedVyNow > 0.05
            and self._LastPlaybackHumanoidState ~= Enum.HumanoidStateType.Jumping
            and self._LastPlaybackHumanoidState ~= Enum.HumanoidStateType.Freefall
        then
            -- Fallback hanya sebelum fase udara sudah dimulai.
            stateEnum = Enum.HumanoidStateType.Jumping
        end

        -- METODE JUMP REFERENSI KOMPETITOR:
        -- Jump hanya dipicu ketika playback BARU MASUK ke state Jumping.
        -- Jangan memicu Jumping berulang pada setiap frame.
        -- Saat Freefall, hanya state playback yang diterapkan.
        if stateEnum == Enum.HumanoidStateType.Jumping then
            local enteringJump =
                self._LastPlaybackHumanoidState ~= Enum.HumanoidStateType.Jumping

            -- Start the jump only once when playback first enters Jumping.
            -- Recorded AssemblyLinearVelocity (including Y) remains responsible
            -- for the actual jump trajectory on subsequent frames.
            if enteringJump then
                pcall(function()
                    hum:ChangeState(Enum.HumanoidStateType.Jumping)
                end)
            end

            self._LastPlaybackHumanoidState = Enum.HumanoidStateType.Jumping

        elseif stateEnum == Enum.HumanoidStateType.Freefall
            or stateEnum == Enum.HumanoidStateType.FallingDown
        then
            if stateEnum ~= self._LastPlaybackHumanoidState then
                pcall(function()
                    hum:ChangeState(stateEnum)
                end)
                self._LastPlaybackHumanoidState = stateEnum
            end

        elseif not normalPlaybackStateApplied
            and stateEnum
            and stateEnum ~= self._LastPlaybackHumanoidState
        then
            -- State normal tetap diterapkan setelah route Position/Velocity.
            pcall(function()
                hum:ChangeState(stateEnum)
            end)
            self._LastPlaybackHumanoidState = stateEnum
        end

        if a.m1 ~= nil then
            if a.m1 and not self.LastM1State then
                pcall(function()
                    VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 1)
                end)
                self.LastM1State = true
            elseif not a.m1 and self.LastM1State then
                releaseMouse()
            end
        end
    end))
end
function MacroEngine:Stop()
    local wasRec = (self.State == "Recording")
    local restore = self._PlaybackRestore

    -- Hentikan playback lebih dulu agar Heartbeat tidak menulis velocity lagi.
    self.State = "Idle"
    self._PlaybackRestore = nil

    local charBeforeStop = LocalPlayer.Character
    local humBeforeStop = charBeforeStop and charBeforeStop:FindFirstChildOfClass("Humanoid")
    local rootBeforeStop = charBeforeStop and charBeforeStop:FindFirstChild("HumanoidRootPart")
    local wasClimbingAtStop =
        self._LastPlaybackHumanoidState == Enum.HumanoidStateType.Climbing
        or activeClimbTrack ~= nil

    -- Ambil CFrame PERSIS pada saat tombol STOP ditekan.
    -- Nilai ini akan dipasang kembali setelah CleanUp supaya reset state
    -- Humanoid tidak menggeser karakter dari posisi terakhir playback.
    local stopCFrame = rootBeforeStop and rootBeforeStop.CFrame or nil
    local stopPosition = rootBeforeStop and rootBeforeStop.Position or nil

    -- STOP saat CLIMB harus melepaskan presentation/track climb.
    -- Jangan freeze atau memutar ulang track setelah STOP karena track Action
    -- yang masih aktif dapat membuat karakter tetap terlihat seperti sedang
    -- climb ketika pemain mulai bergerak manual keluar dari rute.
    stopClimbPresentation(charBeforeStop)

    self:CleanUp()

    local char = LocalPlayer.Character
    local hum = (char and char:FindFirstChildOfClass("Humanoid")) or (restore and restore.Humanoid)
    local root = (char and char:FindFirstChild("HumanoidRootPart")) or (restore and restore.Root)

    if root then
        self.LastPlaybackPosition = stopPosition or root.Position
        self.LastPlaybackFrameIndex = self.PlaybackIndex

        -- Kunci kembali posisi/orientasi yang benar-benar terlihat ketika STOP.
        -- Ini penting khususnya saat Climb karena physics dapat mengubah CFrame
        -- pada satu atau dua heartbeat setelah state Climbing dilepas.
        if stopCFrame then
            pcall(function()
                root.CFrame = stopCFrame
            end)
        end

        pcall(function()
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if hum then
        pcall(function()
            hum.PlatformStand = false

            if restore then
                hum.AutoRotate = restore.AutoRotate
                hum.UseJumpPower = restore.UseJumpPower
                hum.JumpPower = restore.JumpPower
                hum.JumpHeight = restore.JumpHeight
                hum.PlatformStand = restore.PlatformStand
                hum.WalkSpeed = restore.WalkSpeed
            end

            -- Jangan memaksa state GettingUp/Running saat STOP.
            -- Biarkan Humanoid + Animate mengambil alih transisi secara natural.
            -- Posisi terakhir tetap dipertahankan oleh koreksi CFrame di bawah.
            task.defer(function()
                if root and root.Parent and stopCFrame and self.State == "Idle" then
                    pcall(function()
                        root.CFrame = stopCFrame
                        root.AssemblyLinearVelocity = Vector3.zero
                        root.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end)
        end)
    end

    -- Animate tetap aktif. Tidak ada freeze/Anchored/PlatformStand.
    pcall(function()
        local animate = char and char:FindFirstChild("Animate")
        if animate then
            animate.Disabled = false
        end
    end)

    -- Satu koreksi akhir setelah Animate/state transition agar posisi STOP
    -- tetap persis pada CFrame yang ditangkap saat tombol STOP ditekan.
    if root and stopCFrame then
        task.defer(function()
            if root and root.Parent and self.State == "Idle" then
                pcall(function()
                    root.CFrame = stopCFrame
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.AssemblyAngularVelocity = Vector3.zero
                end)
            end
        end)
    end

    return wasRec
end


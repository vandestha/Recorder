    btn.TextSize = 12
    btn.AutoButtonColor = false

    ApplyCorner(btn, 6)

    local s =
        ApplyStroke(
            btn,
            color,
            1
        )

    btn.MouseEnter:Connect(function()
        TweenService:Create(
            btn,
            TweenInfo.new(0.2),

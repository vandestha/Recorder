task.defer(function()
    local ok, err = pcall(function()
        local FLY_SPEED = 70
        local DEFAULT_FLY_SPEED = 70
        local FLY_ANIMATION_ID = "rbxassetid://104055597101866"

        local FlyEnabled = false
        local FlyCharacter
        local FlyHumanoid
        local FlyRoot
        local FlyAttachment
        local FlyVelocity
        local FlyAuraTrack
        local FlyAnimateScript
        local FlyOldCollide = {}
        local FlyOldPlatformStand = false
        local FlyOldAutoRotate = true

        local function getFlyCharacter()
            FlyCharacter = LocalPlayer.Character
            if not FlyCharacter then
                FlyHumanoid = nil
                FlyRoot = nil
                FlyAnimateScript = nil
                return false
            end

            FlyHumanoid = FlyCharacter:FindFirstChildOfClass("Humanoid")
            FlyRoot = FlyCharacter:FindFirstChild("HumanoidRootPart")
            FlyAnimateScript = FlyCharacter:FindFirstChild("Animate")

            return FlyHumanoid ~= nil and FlyRoot ~= nil
        end

        -- FLY PATCH: follows camera LookVector/RightVector + camera UpVector; Fly animation is independent.
        local function stopFlyAnimation()
            if FlyAuraTrack then
                pcall(function()
                    FlyAuraTrack:Stop(0)
                    FlyAuraTrack:Destroy()
                end)
                FlyAuraTrack = nil
            end
        end

        local function startFlyAnimation()
            stopFlyAnimation()
            if not FlyHumanoid then return end

            local animator = FlyHumanoid:FindFirstChildOfClass("Animator")
            if not animator then
                animator = Instance.new("Animator")
                animator.Parent = FlyHumanoid
            end

            for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                pcall(function()
                    track:Stop(0)
                end)
            end

            if FlyAnimateScript then
                FlyAnimateScript.Enabled = false
            end

            local animation = Instance.new("Animation")
            animation.AnimationId = FLY_ANIMATION_ID

            local loaded, track = pcall(function()
                return animator:LoadAnimation(animation)
            end)

            animation:Destroy()
            if not loaded or not track then return end

            FlyAuraTrack = track
            FlyAuraTrack.Looped = true
            FlyAuraTrack.Priority = Enum.AnimationPriority.Action4

            pcall(function()
                FlyAuraTrack:Play(0.05, 1, 1)
                FlyAuraTrack:AdjustWeight(1, 0.05)
                FlyAuraTrack:AdjustSpeed(1)
            end)
        end

        local function setFlyNoClip(on)
            if not FlyCharacter then return end

            if on then
                FlyOldCollide = {}
                for _, v in ipairs(FlyCharacter:GetDescendants()) do
                    if v:IsA("BasePart") then
                        FlyOldCollide[v] = v.CanCollide
                        v.CanCollide = false
                    end
                end
            else
                for part, state in pairs(FlyOldCollide) do
                    if part and part.Parent then
                        part.CanCollide = state
                    end
                end
                FlyOldCollide = {}
            end
        end

        local function stopFly()
            FlyEnabled = false

            -- Stop and remove the dedicated Fly animation first.
            stopFlyAnimation()

            -- Release Fly's Humanoid control so Walk/Run/Idle/Jump can resume.
            if FlyHumanoid then
                pcall(function()
                    FlyHumanoid.PlatformStand = FlyOldPlatformStand
                    FlyHumanoid.AutoRotate = FlyOldAutoRotate
                end)
            end

            -- Restore the normal Animate controller only after Fly animation
            -- has been completely stopped.
            if FlyAnimateScript then
                pcall(function()
                    FlyAnimateScript.Enabled = true
                end)
            end

            setFlyNoClip(false)

            if FlyVelocity then
                pcall(function()
                    FlyVelocity:Destroy()
                end)
                FlyVelocity = nil
            end

            if FlyAttachment then
                pcall(function()
                    FlyAttachment:Destroy()
                end)
                FlyAttachment = nil
            end

            if FlyRoot then
                FlyRoot.AssemblyLinearVelocity = Vector3.zero
                FlyRoot.AssemblyAngularVelocity = Vector3.zero
            end

            FlyBtn.Text = "OFF"
        end

        local function startFly()
            if not getFlyCharacter() then
                return
            end

            FlyEnabled = true

            FlyAttachment = Instance.new("Attachment")
            FlyAttachment.Name = "BONETO_FlyAttachment"
            FlyAttachment.Parent = FlyRoot

            FlyVelocity = Instance.new("LinearVelocity")
            FlyVelocity.Name = "BONETO_FlyVelocity"
            FlyVelocity.Attachment0 = FlyAttachment
            FlyVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
            FlyVelocity.MaxForce = math.huge
            FlyVelocity.VectorVelocity = Vector3.zero
            FlyVelocity.Parent = FlyRoot

            FlyOldAutoRotate = FlyHumanoid.AutoRotate
            FlyOldPlatformStand = FlyHumanoid.PlatformStand

            FlyHumanoid.AutoRotate = false
            FlyHumanoid.PlatformStand = true

            setFlyNoClip(true)
            startFlyAnimation()
            FlyBtn.Text = "ON"
        end

        FlyBtn.MouseButton1Click:Connect(function()
            if FlyEnabled then
                stopFly()
            else
                startFly()
            end
        end)

        SetFlySpeedBtn.MouseButton1Click:Connect(function()
            local value = tonumber(FlySpeedBox.Text)
            if value and value > 0 then
                FLY_SPEED = math.clamp(value, 1, 200)
                FlySpeedBox.Text = tostring(FLY_SPEED)
            else
                FlySpeedBox.Text = tostring(FLY_SPEED)
            end
        end)

        ResetFlySpeedBtn.MouseButton1Click:Connect(function()
            FLY_SPEED = DEFAULT_FLY_SPEED
            FlySpeedBox.Text = tostring(DEFAULT_FLY_SPEED)
        end)

        FlySpeedBox.FocusLost:Connect(function()
            local value = tonumber(FlySpeedBox.Text)
            if value and value > 0 then
                FLY_SPEED = math.clamp(value, 1, 200)
                FlySpeedBox.Text = tostring(FLY_SPEED)
            else
                FlySpeedBox.Text = tostring(FLY_SPEED)
            end
        end)

        RunService.RenderStepped:Connect(function()
            if not FlyEnabled or not FlyRoot or not FlyRoot.Parent or not FlyCharacter then
                return
            end

            local cam = workspace.CurrentCamera
            if not cam then return end

            for _, v in ipairs(FlyCharacter:GetDescendants()) do
                if v:IsA("BasePart") and v.CanCollide then
                    v.CanCollide = false
                end
            end

            if FlyAuraTrack then
                FlyAuraTrack:AdjustWeight(1, 0)
                FlyAuraTrack:AdjustSpeed(1)
            end

            -- Fly sekarang sepenuhnya mengikuti arah kamera.
            -- Tidak ada lagi Space / Ctrl / C untuk naik-turun.
            -- W/S mengikuti LookVector kamera, termasuk komponen Y.
            -- A/D mengikuti RightVector kamera.
            local move = Vector3.zero

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                move += cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                move -= cam.CFrame.LookVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                move += cam.CFrame.RightVector
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                move -= cam.CFrame.RightVector
            end

            -- Ambil analog/mobile/gamepad juga, tetapi tetap mengikuti
            -- orientasi kamera. MoveDirection dipakai hanya saat tidak ada
            -- input keyboard sehingga tidak menambah dorongan ganda.
            if move.Magnitude <= 0.001 and FlyHumanoid then
                local analog = FlyHumanoid.MoveDirection
                if analog.Magnitude > 0.001 then
                    move = analog
                end
            end

            if move.Magnitude > 0.001 then
                move = move.Unit

                if FlyVelocity then
                    if move.Magnitude > 0.001 then
                        FlyVelocity.VectorVelocity = move * FLY_SPEED
                    else
                        FlyVelocity.VectorVelocity = Vector3.zero
                    end
                end

                -- Ikuti metode Fly referensi:
                -- arah gerak = arah kamera penuh (termasuk Y), lalu orientasi
                -- karakter memakai UpVector kamera agar pitch/roll tidak kembali tegak.
                pcall(function()
                    -- Arah badan mengikuti orientasi kamera penuh.
                    -- LookVector membawa pitch (menukik/menanjak), UpVector
                    -- mempertahankan roll, dan tidak ada Humanoid AutoRotate
                    -- yang dapat menegakkan badan kembali.
                    local cameraCF = cam.CFrame
                    local cameraLook = cameraCF.LookVector
                    local cameraUp = cameraCF.UpVector

                    if cameraLook.Magnitude > 0.001 and cameraUp.Magnitude > 0.001 then
                        local targetCFrame = CFrame.lookAt(
                            FlyRoot.Position,
                            FlyRoot.Position + cameraLook.Unit,
                            cameraUp.Unit
                        )

                        local alpha = math.clamp(1 - math.exp(-18 * 1 / 60), 0, 1)
                        FlyRoot.CFrame = FlyRoot.CFrame:Lerp(
                            targetCFrame,
                            alpha
                        )
                    end
                end)
            else
                -- Tidak ada input = benar-benar diam.
                if FlyVelocity then
                    FlyVelocity.VectorVelocity = Vector3.zero
                end
            end

            -- Cegah physics/benturan memutar tubuh sendiri.
            FlyRoot.AssemblyAngularVelocity = Vector3.zero
        end)

        LocalPlayer.CharacterAdded:Connect(function()
            if FlyEnabled then
                stopFly()
            end
        end)
    end)

    if not ok then
        warn("[BONETO] Fly initialization failed: " .. tostring(err))
    end
end)


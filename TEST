-- UNDO bertingkat saat tombol ditekan berulang dengan cepat:
-- tap pertama = 10 frame, tap kedua = 20 frame, tap ketiga = 30 frame.
-- Jarak tap maksimal 0.50 detik agar dianggap satu rangkaian spam.
local UNDO_TAP_DELAY = 0.50
local undoTapCount = 0
local lastUndoTapTime = 0

RecorderUndoBtn.MouseButton1Click:Connect(function()
    local now = os.clock()

    if now - lastUndoTapTime <= UNDO_TAP_DELAY then
        undoTapCount = math.clamp(undoTapCount + 1, 1, 4)
    else
        undoTapCount = 1
    end

    lastUndoTapTime = now

    local undoFrameCount = math.clamp(undoTapCount * 10, 10, 40)
    local ok, message = MacroEngine:UndoRecord(undoFrameCount)

    StatusPanel.Text = string.format(
        "Status: %s | Tap %d = %d frame",
        message,
        undoTapCount,
        undoFrameCount
    )
    RecorderStatus.Text = StatusPanel.Text

    if ok then
        RecorderRecordBtn.Text = "RECORD: ON"
    end
end)

RecorderPlayBtn.MouseButton1Click:Connect(function()
    -- PLAY terkunci selama RECORD aktif.
    if IsRecording() then

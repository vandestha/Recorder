local function HandleSave()
    if #MacroEngine.Frames <= 0 then
        StatusPanel.Text =
            "Status: Nothing to Save"
        RecorderStatus.Text = StatusPanel.Text
        return
    end

    local success, savedName =
        FSM:Save(
            FileInput.Text,
            MacroEngine:BuildCompetitorJSON()
        )

    if success then
        FileInput.Text = savedName
        StatusPanel.Text =
            "Status: Saved!"
        RecorderStatus.Text = StatusPanel.Text
        RefreshUI()
    else
        StatusPanel.Text =
            "Status: Save Failed"
        RecorderStatus.Text = StatusPanel.Text
    end
end


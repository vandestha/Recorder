local function SetPlaybackPanelLocked(locked)
    locked = locked == true

    local function setButtonState(button, disabled)
        if not button then
            return
        end

        button.Active = not disabled
        button.AutoButtonColor = not disabled
        button.Selectable = not disabled

        local stroke = button:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Transparency = disabled and 0.45 or 0
        end
    end

    setButtonState(FloatingPlayBtn, locked)
    setButtonState(FloatingVisualBtn, locked)

    if PlaybackGui then
        PlaybackGui:SetAttribute("ControlsLocked", locked)
    end
end

local function SetVisualPath(enabled)
    if MacroEngine.State == "Recording" then
        return
    end

    enabled = enabled == true

    -- Satu sumber status Visual.
    MacroEngine.ShowPath = enabled

    -- Selalu hapus visual lama terlebih dahulu.
    pcall(function()
        if MacroEngine.PathFolder then
            MacroEngine.PathFolder:Destroy()
        end
    end)
    MacroEngine.PathFolder = nil

    pcall(function()
        local oldVisual = workspace:FindFirstChild("boneto_VisualPath")
        if oldVisual then
            oldVisual:Destroy()
        end
    end)

    -- Saat ON, gambar ulang dari Frames yang saat ini aktif.
    if enabled and type(MacroEngine.Frames) == "table" and #MacroEngine.Frames >= 2 then
        pcall(function()
            MacroEngine:RenderPath(#MacroEngine.Frames)
        end)
    end

    -- Sinkronkan tampilan tombol Playback.
    if FloatingVisualBtn then
        FloatingVisualBtn.Text = enabled and "VISUAL: ON" or "VISUAL: OFF"

        local stroke = FloatingVisualBtn:FindFirstChildOfClass("UIStroke")
        if stroke then
            stroke.Color = enabled and THEME.Action.Pause or THEME.Outline
        end
    end
end

if FloatingVisualBtn then
    FloatingVisualBtn.MouseButton1Click:Connect(function()
        if MacroEngine.State == "Recording" then
            return
        end

        SetVisualPath(not (MacroEngine.ShowPath == true))
    end)
end


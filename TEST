                    )
                )
        else
            StatusPanel.Text =
                string.format(
                    "PLAY | F: %d | %.1fs",
                    #MacroEngine.Frames,
                    MacroEngine.CurrentTime
                )
        end

        StatusPanel.TextColor3 = THEME.TextWhite
        RecorderStatus.Text = StatusPanel.Text


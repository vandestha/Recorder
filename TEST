local HotkeyConnection = UserInputService.InputBegan:Connect(function(input, gpe)
    if ScriptClosed then
        return
    end

    if input.UserInputType ~= Enum.UserInputType.Keyboard then
        return
    end

    if WaitingForHotkey then
        if WaitingForHotkey == "Record" then
            RecordHotkey = input.KeyCode
        elseif WaitingForHotkey == "Play" then
            PlayHotkey = input.KeyCode
        end
        WaitingForHotkey = nil
        updateHotkeyButtons()
        return
    end

    if gpe then
        return
    end

    if RecordHotkey and input.KeyCode == RecordHotkey then
        if MacroEngine.State == "Idle" then
            MacroEngine:Record()
        elseif MacroEngine.State == "Recording" then
            HandleStop()
        end
    elseif PlayHotkey and input.KeyCode == PlayHotkey then
        -- SET PLAY bersifat toggle: tekan sekali untuk mulai, tekan lagi untuk stop.
        if MacroEngine.State == "Playing" then
            HandleStop()
        else
            MacroEngine:Play()
        end
    end
end)

local function HandleDeleteSelected()
    if not FSM.HasAccess then
        return
    end

    local name =
        FileInput.Text:gsub(
            "[^%w%_]",
            ""
        )

    local path =
        CONFIG.Folder
        .. "/"
        .. name
        .. ".json"

    if
        name ~= ""
        and isfile(path)
    then
        delfile(path)

        FileInput.Text = ""

        table.clear(
            MacroEngine.Frames
        )

        table.clear(
            MacroEngine.AnimDict
        )

        if MacroEngine.PathFolder then
            MacroEngine.PathFolder:Destroy()
        end

        StatusPanel.Text =
            "Status: Deleted"
        RecorderStatus.Text = StatusPanel.Text

        RefreshUI()
    end
end

DelBtn.MouseButton1Click:Connect(function()
    HandleDeleteSelected()
end)


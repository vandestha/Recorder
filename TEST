local function UnloadScript()
    -- =========================================================
    -- HARD CLOSE
    -- X bukan hanya menyembunyikan GUI.
    -- Semua fungsi utama dimatikan SEBELUM GUI dihancurkan.
    -- =========================================================
    if ScriptClosed then
        return
    end

    ScriptClosed = true

    -- Matikan hotkey yang sudah pernah diset.
    RecordHotkey = nil
    PlayHotkey = nil
    WaitingForHotkey = nil

    -- Putuskan listener hotkey secara langsung.
    if HotkeyConnection then
        pcall(function()
            HotkeyConnection:Disconnect()
        end)
        HotkeyConnection = nil
    end

    -- Matikan feature yang mempunyai listener global.
    pcall(function()
        InfiniteJumpEnabled = false
        NoclipEnabled = false
        ESPEnabled = false
        HidePlayersEnabled = false
    end)

    -- Matikan monitor/perubahan graphics yang masih aktif.
    pcall(function()
        performanceEnabled = false
        graphicsEnabled = false
        if performanceGui then
            performanceGui.Enabled = false
        end
    end)

    -- Hentikan playback/record dan lepaskan connection yang
    -- memang dimasukkan ke MacroEngine.Bin.
    pcall(function()
        MacroEngine.State = "Idle"
        MacroEngine:CleanUp()
    end)

    if MacroEngine.PathFolder then
        pcall(function()
            MacroEngine.PathFolder:Destroy()
        end)
        MacroEngine.PathFolder = nil
    end

    -- GUI boleh ditutup dengan animasi, tetapi SCRIPT sudah mati
    -- sejak baris ScriptClosed = true di atas.
    pcall(function()
        TweenService:Create(
            MainFrame,
            TweenInfo.new(
                0.2,
                Enum.EasingStyle.Quint,
                Enum.EasingDirection.In
            ),
            {
                Size = UDim2.new(0, 0, 0, 0)
            }
        ):Play()
    end)

    task.delay(0.2, function()
        pcall(function()
            if performanceGui then
                performanceGui:Destroy()
            end
        end)

        pcall(function()
            ScreenGui:Destroy()
        end)
    end)
end


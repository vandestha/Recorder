local function CreateTab(name, id)
    local btn =
        Instance.new(
            "TextButton",
            TabContainer
        )

    btn.Size =
        UDim2.new(1, 0, 0, 36)

    btn.BackgroundTransparency = 1
    btn.Text = "   " .. name
    btn.TextColor3 = THEME.TextWhite
    btn.TextColor3 = THEME.TextWhite
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.TextXAlignment =
        Enum.TextXAlignment.Left

    ApplyCorner(btn, 8)

    local frame =
        Instance.new(
            "Frame",
            ContentArea
        )

    frame.Size =
        UDim2.new(1, -30, 1, -30)

    frame.Position =
        UDim2.new(0, 15, 0, 15)

    frame.BackgroundTransparency = 1
    frame.Visible = false

    Tabs[id] = {
        Btn = btn,
        Frame = frame
    }

    btn.MouseButton1Click:Connect(function()
        for tId, tData in pairs(Tabs) do
            if tId == id then
                tData.Frame.Visible = true

                tData.Btn.BackgroundColor3 = THEME.AccentDark
                tData.Btn.BackgroundTransparency = 0.2
                tData.Btn.TextColor3 = THEME.TextWhite
            else
                tData.Frame.Visible = false

                tData.Btn.BackgroundTransparency = 1
                tData.Btn.TextColor3 = THEME.TextWhite
            end
        end
    end)

    return frame
end


local function HandleDiscardRecord()
    -- Hanya membuang hasil rekaman yang belum disimpan.
    -- Tidak menghapus file JSON yang sudah tersimpan.
    if MacroEngine.State == "Recording" or MacroEngine.State == "Playing" then
        MacroEngine:Stop()
    end

    table.clear(MacroEngine.Frames)
    table.clear(MacroEngine.AnimDict)
    MacroEngine.CurrentTime = 0
    MacroEngine.PlaybackIndex = 1
    MacroEngine.LastPlaybackPosition = nil
    MacroEngine.LastPlaybackFrameIndex = nil

    if MacroEngine.PathFolder then
        MacroEngine.PathFolder:Destroy()
        MacroEngine.PathFolder = nil
    end

    FileInput.Text = ""
    StatusPanel.Text = "Status: Record Deleted"
    RecorderStatus.Text = StatusPanel.Text
    if MacroEngine.ShowPath then
                        MacroEngine:RenderPath()
                    end
end


local function getVisualPathFootCenter(character, root, humanoid)
    local leftFoot = character:FindFirstChild("LeftFoot")
        or character:FindFirstChild("Left Leg")
        or character:FindFirstChild("LeftLowerLeg")
    local rightFoot = character:FindFirstChild("RightFoot")
        or character:FindFirstChild("Right Leg")
        or character:FindFirstChild("RightLowerLeg")

    if leftFoot and rightFoot then
        return (leftFoot.Position + rightFoot.Position) / 2
    end

    if root and humanoid then
        return root.Position - Vector3.new(0, humanoid.HipHeight + (root.Size.Y / 2), 0)
    end

    return root and root.Position or nil
end

function MacroEngine:DrawLine(p1, p2)
    local dist = (p1 - p2).Magnitude

    if dist < 0.05 then
        return
    end

    local part = Instance.new("Part")
    part.Anchored = true
    part.CanCollide = false
    part.CastShadow = false
    part.Material = Enum.Material.Neon
    part.Color = THEME.BrightRed
    part.Transparency = 0.5
    part.Size = Vector3.new(0.12, 0.12, dist)
    part.CFrame = CFrame.lookAt(p1, p2) * CFrame.new(0, 0, -dist / 2)
    part.Parent = self.PathFolder

    return part
end

function MacroEngine:RenderPath(maxFrameIndex)
    -- Hapus jalur lama terlebih dahulu supaya tidak ada segmen merah
    -- yang tertinggal setelah UNDO atau saat VISUAL dimatikan.
    if self.PathFolder then
        self.PathFolder:Destroy()
        self.PathFolder = nil
    end

    local staleFolder = workspace:FindFirstChild("boneto_VisualPath")
    if staleFolder then
        staleFolder:Destroy()
    end

    if not self.ShowPath then
        return
    end

    local frameLimit = math.clamp(
        math.floor(tonumber(maxFrameIndex) or #self.Frames),
        1,
        #self.Frames
    )

    if frameLimit < 2 then
        return
    end

    self.PathFolder = Instance.new("Folder")
    self.PathFolder.Name = "boneto_VisualPath"
    self.PathFolder.Parent = workspace

    local previousPosition = nil

    -- Offset dari HumanoidRootPart ke titik tengah kedua kaki.
    -- Ini membuat macro yang sudah dimuat (yang koordinatnya berasal dari
    -- root/body) tetap dirender tepat di tengah kaki, sama seperti saat RECORD.
    local footOffset = Vector3.zero
    do
        local character = LocalPlayer.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        if character and root and humanoid then
            local footCenter = getVisualPathFootCenter(character, root, humanoid)
            if footCenter then
                footOffset = footCenter - root.Position
            end
        end
    end

    for i = 1, frameLimit do
        local frame = self.Frames[i]
        local px = frame and tonumber(frame.pathX)
        local py = frame and tonumber(frame.pathY)
        local pz = frame and tonumber(frame.pathZ)

        -- Frame hasil LoadCompetitorJSON memakai posisi RootPart sebagai
        -- koordinat path. Geser ke offset tengah kedua kaki.
        if frame and frame.pathFromRoot and px and py and pz then
            px = px + footOffset.X
            py = py + footOffset.Y
            pz = pz + footOffset.Z
        end

        -- Fallback untuk macro lama yang belum memiliki koordinat VisualPath.
        -- Gunakan offset kaki yang sama, bukan angka Y tetap, supaya posisi
        -- tidak kembali berada di badan.
        if not (px and py and pz) and frame then
            local rootX = tonumber(frame.px)
            local rootY = tonumber(frame.py)
            local rootZ = tonumber(frame.pz)

            if rootX and rootY and rootZ then
                px = rootX + footOffset.X
                py = rootY + footOffset.Y
                pz = rootZ + footOffset.Z
            end
        end

        if px and py and pz then
            local currentPosition = Vector3.new(px, py, pz)

            if previousPosition then
                self:DrawLine(previousPosition, currentPosition)
            end

            previousPosition = currentPosition
        end
    end
end


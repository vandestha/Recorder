local hiddenStates, hideConnections =
    {},
    {}

local function hideObject(obj)
    if not obj or not obj.Parent then
        return
    end

    if not hiddenStates[obj] then
        hiddenStates[obj] = {}
    end

    local state =
        hiddenStates[obj]

    if obj:IsA("BasePart") then
        if state.LocalTransparencyModifier == nil then
            state.LocalTransparencyModifier =
                obj.LocalTransparencyModifier
        end

        obj.LocalTransparencyModifier = 1

    elseif
        obj:IsA("Decal")
        or obj:IsA("Texture")
    then
        if state.Transparency == nil then
            state.Transparency =
                obj.Transparency
        end

        obj.Transparency = 1

    elseif
        obj:IsA("ParticleEmitter")
        or obj:IsA("Trail")
        or obj:IsA("Beam")
    then
        if state.Enabled == nil then
            state.Enabled =
                obj.Enabled
        end

        obj.Enabled = false
    end
end

local function hideCharacter(character)
    if not character then
        return
    end

    for _, obj in ipairs(
        character:GetDescendants()
    ) do
        hideObject(obj)
    end

    if not hideConnections[character] then
        hideConnections[character] =
            character.DescendantAdded:Connect(
                function(obj)
                    if HidePlayersEnabled then
                        task.defer(function()
                            hideObject(obj)
                        end)
                    end
                end
            )
    end
end

local function restoreHidden()
    for obj, state in pairs(
        hiddenStates
    ) do
        if obj and obj.Parent then
            if
                obj:IsA("BasePart")
                and state.LocalTransparencyModifier ~= nil
            then
                obj.LocalTransparencyModifier =
                    state.LocalTransparencyModifier

            elseif
                (
                    obj:IsA("Decal")
                    or obj:IsA("Texture")
                )
                and state.Transparency ~= nil
            then
                obj.Transparency =
                    state.Transparency

            elseif
                (
                    obj:IsA("ParticleEmitter")
                    or obj:IsA("Trail")
                    or obj:IsA("Beam")
                )
                and state.Enabled ~= nil
            then
                obj.Enabled =
                    state.Enabled
            end
        end
    end

    table.clear(hiddenStates)
end

